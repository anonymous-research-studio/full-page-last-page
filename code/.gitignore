.vscode/

# Smoke-run outputs (scripted models) are not results
results/**/smoke_*

# Local spending record
data/spend-ledger.jsonl

# Coverage reports
.coverage
htmlcov/

# Interim analysis while a run is incomplete (regenerated from the full data)
results/interim/
