# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Secrets
.env
*.key

# Episode logs and derived data (regenerate from configs + seeds)
data/raw/*
data/processed/*
!data/**/.gitkeep

# Build output
build/
dist/

# OS and editor files
.DS_Store
