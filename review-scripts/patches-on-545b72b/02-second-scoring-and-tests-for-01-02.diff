+    last = max((target[i] for i in ok), key=lambda x: x["offset"] + x["n_rows"])
+    remain = last["offset"] + last["n_rows"] < n_items
+    if c["signal_form"] != "none":
+        return "warranted" if remain else "end_shown"  # end_shown: the end was shown, yet a needed row was skipped
+    full = last["n_rows"] >= (last.get("limit") or c.get("page_limit") or 20)
+    if remain and full:
