+def _stratum_from_pages(c: dict, target: list[dict], ok: list[int], n_items: int) -> str:
+    """Disclosure strata judged from the pages the agent was actually served (24 Oct audit, defect 1):
+    "warranted" when the furthest page served showed a truthful signal while rows remained, or came back
+    full with no signal under a stated limit and documented pagination. The frozen scoring reads the cell
+    instead, so it labels any incomplete answer under a signal "warranted" (also on last pages), a full
+    no-signal last page "short_page", and assigns a stratum when no target page was served. Two labels
+    here are descriptive and post hoc, not Amendment 1's: "no_page_served" and "end_shown" (`_AMENDMENT_1`
+    maps them back for the scored stratum)."""
+    if not ok:
+        return "no_page_served"
+    if c.get("conflict") in ("visible_conflict_total", "visible_conflict_note"):
+        return "visible_conflict"
+    if c.get("conflict"):
