+def test_html_only_leaves_the_csv_and_verdicts_untouched(make_condition, tmp_path):
+    raw = tmp_path / "m.jsonl"
+    raw.write_text(json.dumps(_scripted(make_condition, "name_one", "FINAL ANSWER: SKU-1")) + "\n")
+    sample = tmp_path / "sample.csv"
+    pd.DataFrame({"audit_id": [1], "episode_id": ["e0"], "model": ["m"], "stratum": ["other"], "weight": [1.0],
