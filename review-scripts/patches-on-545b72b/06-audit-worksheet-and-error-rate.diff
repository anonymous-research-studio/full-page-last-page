+def test_worksheet_refuses_a_sample_without_raw_records(tmp_path):
+    (tmp_path / "m.jsonl").write_text("")
+    with pytest.raises(SystemExit):
+        audit_worksheet.build(pd.DataFrame({"audit_id": [1], "episode_id": ["x"], "model": ["m"], "stratum": ["other"],
+                                            "weight": [1.0], "scorer_final_answer": [""]}), [str(tmp_path / "m.jsonl")])
+
+
+def _filled(verdicts, strata, weights):
+    return pd.DataFrame({"audit_id": range(1, len(verdicts) + 1), "episode_id": [f"e{i}" for i in range(len(verdicts))],
+                         "model": "m", "stratum": strata, "weight": weights, "verdict": verdicts})
+
+
+def test_weighted_rate_uses_the_stratum_weights():
+    d = _filled(["disagree", "agree", "agree", "agree"], ["a", "a", "b", "b"], [10, 10, 30, 30])
+    per_model, per_stratum = audit_error_rate.rates(d, n_boot=200)
+    row = per_model.iloc[0]
+    assert row["weighted_error_rate"] == pytest.approx(10 / 80) and row["unweighted_error_rate"] == pytest.approx(0.25)
+    assert row["bootstrap_lo"] <= row["weighted_error_rate"] <= row["bootstrap_hi"] and row["population_share_covered"] == 1
+    assert row["kish_n_eff"] == pytest.approx(80**2 / (2 * 10**2 + 2 * 30**2))  # (sum w)^2 / sum w^2 = 3.2
+    assert row["wilson_kish_lo"] <= row["weighted_error_rate"] <= row["wilson_kish_hi"]
+    assert list(per_stratum["disagree"]) == [1, 0]
+
+
+def test_wilson_interval_keeps_an_upper_bound_when_no_reply_is_an_error():
+    from statsmodels.stats.proportion import proportion_confint
+
+    d = _filled(["agree"] * 6, ["a", "a", "a", "b", "b", "b"], [10, 10, 10, 30, 30, 30])
+    row = audit_error_rate.rates(d, n_boot=200)[0].iloc[0]
+    assert (row["weighted_error_rate"], row["bootstrap_lo"], row["bootstrap_hi"]) == (0, 0, 0)  # the bootstrap collapses
+    n_eff = 120**2 / (3 * 10**2 + 3 * 30**2)
+    assert row["wilson_kish_lo"] == pytest.approx(0, abs=1e-12)
+    assert row["wilson_kish_hi"] == pytest.approx(proportion_confint(0, n_eff, method="wilson")[1]) and row["wilson_kish_hi"] > 0
+
+
+def test_unsure_and_blank_verdicts_are_bounded_and_reported():
+    d = _filled(["disagree", "unsure", "agree", ""], ["a", "a", "b", "b"], [10, 10, 30, 30])
+    row = audit_error_rate.rates(d, n_boot=200)[0].iloc[0]
+    assert (row["unsure"], row["not_yet_audited"]) == (1, 1)
+    assert row["weighted_error_rate"] == pytest.approx(10 / 40)            # agree/disagree only
+    assert row["lower_bound_unsure_as_agree"] == pytest.approx(10 / 50)
+    assert row["upper_bound_unsure_as_disagree"] == pytest.approx(20 / 50)
+    assert row["population_share_covered"] == pytest.approx(40 / 80)
+
+
+def _part(tmp_path, verdicts, ids=None, name="p", episodes=None):
+    """A worksheet with blank verdict columns and a verdicts-only file (audit_id, verdict, note)."""
+    n = len(verdicts)
+    w = _filled([""] * n, ["a"] * n, [1.0] * n)
+    if episodes:
+        w["episode_id"] = episodes
+    w["note"] = ""
+    ws, vs = tmp_path / f"{name}_worksheet.csv", tmp_path / f"{name}_verdicts.csv"
+    w.to_csv(ws, index=False)
+    pd.DataFrame({"audit_id": ids if ids is not None else range(1, n + 1), "verdict": verdicts,
+                  "note": [""] * len(verdicts)}).to_csv(vs, index=False)
+    return str(ws), str(vs)
+
+
+def test_verdicts_are_merged_by_audit_id(tmp_path):
+    ws, vs = _part(tmp_path, ["agree", "Disagree", ""], ids=[3, 1, 2])
+    d = audit_error_rate.read([(ws, vs)])
+    assert dict(zip(d["audit_id"], d["verdict"], strict=True)) == {1: "disagree", 2: "", 3: "agree"}
+
+
+@pytest.mark.parametrize(("verdicts", "ids", "message"), [
+    (["agree", "agree"], [1, 2, 3][:2], None),                       # a part with a missing id: built below
+    (["agree", "agree", "agree", "agree"], [1, 2, 3, 4], "not in"),  # an id the worksheet lacks
+    (["agree", "agree", "agree"], [1, 2, 2], "duplicated audit id"),
+    (["agree", "maybe", "agree"], [1, 2, 3], "check audit id"),
+])
+def test_bad_verdict_files_stop_the_script(tmp_path, verdicts, ids, message):
+    if message is None:  # the worksheet has 3 replies, the verdicts file only 2
+        ws, _ = _part(tmp_path, ["", "", ""])
+        _, vs = _part(tmp_path, verdicts, ids=ids, name="short")
+        message = "missing"
+    else:
+        ws, _ = _part(tmp_path, ["", "", ""])
+        _, vs = _part(tmp_path, verdicts, ids=ids, name="bad")
+    with pytest.raises(SystemExit, match=message):
+        audit_error_rate.read([(ws, vs)])
+
+
+def test_an_episode_in_two_parts_stops_the_script(tmp_path):
+    one = _part(tmp_path, ["agree"], name="one", episodes=["e1"])
+    two = _part(tmp_path, ["agree"], name="two", episodes=["e1"])
+    with pytest.raises(SystemExit, match="two parts"):
+        audit_error_rate.read([one, two])
