+"""The audit worksheet and the stratum-weighted parser error rate (scripts/audit_worksheet.py, audit_error_rate.py)."""
+
+import html
+import importlib.util
+import json
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from fplp.agents.scripted import ScriptedClient
+from fplp.episode import run_episode
+from fplp.tasks.specs import build_episode
+
+
+def _load(name):
+    spec = importlib.util.spec_from_file_location(name, Path(__file__).parents[1] / "scripts" / f"{name}.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+audit_worksheet, audit_error_rate = _load("audit_worksheet"), _load("audit_error_rate")
+
+
+def test_worksheet_shows_each_reply_and_writes_a_verdicts_file(make_condition, tmp_path):
+    raw = tmp_path / "m.jsonl"
+    with raw.open("w") as fh:
+        for i, form in enumerate(["has_more", "none"]):
+            rec = run_episode(ScriptedClient("f", "follow_all"), build_episode(make_condition(form, "filtered_count", i)),
+                              max_tool_calls=12)
+            rec.update(episode_id=f"e{i}", model="m", final_text="FINAL ANSWER: <3> & more")
+            fh.write(json.dumps(rec) + "\n")
+    sample = pd.DataFrame({"audit_id": [2, 1], "episode_id": ["e0", "e1"], "model": ["m", "m"],
+                           "stratum": ["other", "exists"], "weight": [10.0, 5.0], "scorer_final_answer": ["<3> & more"] * 2})
+    table = audit_worksheet.build(sample, [str(raw)])
+    assert list(table["audit_id"]) == [1, 2] and "verdict" not in table and "note" not in table
+    assert table["calls_summary"].str.contains("rows seen: ").all() and table["calls_summary"].str.contains("rows 1-").all()
+    page = audit_worksheet.to_html(table, "t", "s", "audit_verdicts_part9.csv")
+    assert "&lt;3&gt; &amp; more" in page and "<3> & more" not in page  # model text is escaped
+    assert page.count("<section id='a") == 2 and "audit_verdicts_part9.csv" in page
+    sample_csv = tmp_path / "sample.csv"
+    sample.to_csv(sample_csv, index=False)
+    out = tmp_path / "audit_worksheet_part9"
+    audit_worksheet.main([str(sample_csv), str(raw), "--out", str(out)])
+    verdicts = tmp_path / "audit_verdicts_part9.csv"
+    v = pd.read_csv(verdicts, dtype=str)
+    assert list(v.columns) == ["audit_id", "verdict", "note"] and list(v["audit_id"]) == ["1", "2"]
+    assert v["verdict"].isna().all()
+    verdicts.write_text("audit_id,verdict,note\n1,agree,\n2,,\n")  # verdicts already entered are never overwritten
+    audit_worksheet.main([str(sample_csv), str(raw), "--out", str(out)])
+    assert "1,agree," in verdicts.read_text()
+
+
+def _scripted(make_condition, task_type, final_text, form="has_more"):
+    rec = run_episode(ScriptedClient("f", "follow_all"), build_episode(make_condition(form, task_type, 0)), max_tool_calls=12)
+    rec.update(episode_id="e0", model="m", final_text=final_text)
+    return rec
+
+
+def test_export_ids_come_from_the_body_when_the_final_line_has_none(make_condition):
+    rec = _scripted(make_condition, "export_all", "")
+    gold = sorted(rec["gold"]["value"])
+    rec["final_text"] = "Open tickets: " + ", ".join([*gold[:-1], "TCK-0"]) + "\n\nFINAL ANSWER: listed above."
+    ids, source = audit_worksheet.scorer_ids(rec)
+    assert source.startswith("from the body") and set(ids) == set(gold[:-1]) | {"TCK-0"}
+    shown = dict(audit_worksheet.extras(rec))
+    against = shown["against the gold IDs"]
+    assert f"{len(gold) - 1} of {len(gold)} gold IDs present" in against and gold[-1] in against and "extra: TCK-0" in against
+    rec["final_text"] = "FINAL ANSWER: " + ", ".join(gold)  # ids on the final line: nothing extra to show
+    assert audit_worksheet.extras(rec) == []
+
+
+def test_name_one_shows_the_served_row_of_the_named_sku(make_condition):
+    rec = _scripted(make_condition, "name_one", "")
+    served = [r for x in rec["calls"] for r in json.loads(x["output"]).get("results", [])]
+    named = served[0]["sku"]
+    rec["final_text"] = f"FINAL ANSWER: {named}"
+    shown = dict(audit_worksheet.extras(rec))
+    assert shown["SKU(s) the scorer took (from the final line)"] == named
+    rule = audit_worksheet.gold_text(rec)
+    accepted = rec["gold"]["accepted"]
+    assert rule.startswith("rule: any in-stock SKU") and f"{len(accepted)} accepted: {', '.join(accepted)}" in rule
+    row = shown[f"served row for {named}"]
+    assert f'"in_stock": {json.dumps(served[0]["in_stock"])}' in row and "served at t" in row
+    rec["final_text"] = "FINAL ANSWER: SKU-1"
+    assert dict(audit_worksheet.extras(rec))["served row for SKU-1"] == "not in any served row"
+
