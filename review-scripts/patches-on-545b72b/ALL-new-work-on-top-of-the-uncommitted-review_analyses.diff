+"""The frozen scoring against the second scoring (`fplp score --fixes`), per model.
+
+The 24 Oct code audit found three latent scoring defects, none affecting gpt-oss-120b's episodes;
+PENDING.md (section 3) fixes them after the runs, reports both scorings, and records the change as a
+deviation. This reports, per model, how many episodes each fix changes and, given both scorings'
+`fplp hypotheses` CSVs, every test whose verdict, estimability or estimate moves.
+
+  uv run fplp score data/raw/main --config configs/runs/main.yaml --cutoff ... --out frozen.csv
+  uv run fplp score data/raw/main --config configs/runs/main.yaml --cutoff ... --fixes --out fixed.csv
+  uv run python scripts/compare_scorings.py frozen.csv fixed.csv [--hypotheses frozen_h.csv fixed_h.csv]
+
+`--exclude-asked-above OUT` also writes the fixed scoring without episodes whose first call asked for
+more rows than the page limit (defect 3), for a sensitivity run of `fplp hypotheses`.
+"""
+
+from __future__ import annotations
+
+import argparse
+
+import pandas as pd
+
+FETCH = ["follow_up", "responsive_follow_up", "followup_calls", "speculative_fetch", "missed_fetch", "extra_fetch"]
+
+
+def _changed(g: pd.DataFrame, col: str) -> int:
+    return int((g[col].fillna(-1).astype(str) != g[f"{col}_fix"].fillna(-1).astype(str)).sum())
+
+
+def episodes(frozen: pd.DataFrame, fixed: pd.DataFrame) -> pd.DataFrame:
+    m = frozen.merge(fixed, on=["episode_id", "model"], suffixes=("", "_fix"), validate="one_to_one")
+    rows = []
+    for model, g in m.groupby("model"):
+        incomplete = g[(g["task_need"] == "needs_all") & (g["evidence_seen"] == 0)]
+        moved = incomplete[incomplete["disclosure_stratum"].fillna("") != incomplete["disclosure_stratum_fix"].fillna("")]
+        rows.append({
+            "model": model, "episodes": len(g),
+            **{f"{c}_changed": _changed(g, c) for c in FETCH},
+            "stratum_changed": len(moved),
+            "stratum_moves": "; ".join(f"{a}->{b}: {n}" for (a, b), n in
+                                       moved.groupby(["disclosure_stratum", "disclosure_stratum_fix"], dropna=False).size().items()),
+            "incomplete_outside_more_extents": int((~incomplete["extent"].isin(["more_full", "more_short"])).sum()),
+            # descriptive and post hoc: labels outside Amendment 1's strata, mapped back in disclosure_stratum
+            "post_hoc_no_page_served": int((g["stratum_post_hoc"] == "no_page_served").sum()),
+            "post_hoc_end_shown": int((g["stratum_post_hoc"] == "end_shown").sum()),
+            "no_target_page": int(g["no_target_page"].sum()),
+            "asked_above_limit": int(g["asked_above_limit"].sum()),
+        })
+    return pd.DataFrame(rows)
+
+
+def hypotheses(frozen: str, fixed: str) -> pd.DataFrame:
+    keys = ["model", "family", "hypothesis", "part", "test"]
+    a, b = pd.read_csv(frozen), pd.read_csv(fixed)
+    m = a.merge(b, on=keys, how="outer", suffixes=("", "_fix"), indicator=True)
+
+    def same(col: str, numeric: bool = False) -> pd.Series:
+        x, y = m[col], m[f"{col}_fix"]
+        both_missing = x.isna() & y.isna()
+        if numeric:
+            return both_missing | ((x - y).abs() <= 1e-9).fillna(False)
+        return both_missing | (x.astype(object) == y.astype(object)).fillna(False)
+
+    differs = (m["_merge"] != "both") | ~same("supported") | ~same("estimable") | ~same("diff", True) | ~same("n", True)
+    return m.loc[differs, [*keys, "n", "n_fix", "diff", "diff_fix", "supported", "supported_fix", "estimable", "estimable_fix"]]
+
+
+def main(argv: list[str] | None = None) -> None:
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("frozen_csv")
+    p.add_argument("fixed_csv")
+    p.add_argument("--hypotheses", nargs=2, metavar=("FROZEN_H", "FIXED_H"))
+    p.add_argument("--out", help="CSV of the per-model episode counts")
+    p.add_argument("--exclude-asked-above", metavar="OUT")
+    args = p.parse_args(argv)
+    frozen, fixed = pd.read_csv(args.frozen_csv), pd.read_csv(args.fixed_csv)
+    table = episodes(frozen, fixed)
+    with pd.option_context("display.width", 250, "display.max_columns", 30, "display.max_colwidth", 80):
+        print(table.to_string(index=False))
+        if args.hypotheses:
+            h = hypotheses(*args.hypotheses)
+            print(f"\n{len(h)} test row(s) differ between the scorings" + (":" if len(h) else ""))
+            if len(h):
+                print(h.to_string(index=False))
+    if args.out:
+        table.to_csv(args.out, index=False)
+    if args.exclude_asked_above:
+        kept = fixed[fixed["asked_above_limit"] == 0]
+        kept.to_csv(args.exclude_asked_above, index=False)
+        print(f"\nwrote {len(kept)} of {len(fixed)} episodes (without first calls above the page limit) to {args.exclude_asked_above}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/cost_of_not_stopping.py b/scripts/cost_of_not_stopping.py
new file mode 100644
index 0000000..809b1aa
--- /dev/null
+++ b/scripts/cost_of_not_stopping.py
@@ -0,0 +1,73 @@
+"""The cost of not stopping: tool calls and input tokens added or saved by each signal (descriptive).
+
+Not a registered or amended test; the paper reports it as a cost (interim 41 in the draft). Computed on
+the amended tests' cells (`fplp.analysis.hypotheses._cells`: core arm, final-line answers, own small
+pages and page-1-settled exists items left out, exclusions applied), per model:
+  - means per form and cell: all tool calls (`n_calls`), follow-up calls on the target query
+    (`followup_calls`), input tokens (`tokens_in`, every input token processed, cached ones included),
+    and cap hits;
+  - paired by item against no signal, with 95% intervals (`fplp.analysis.common.paired`): calls and
+    tokens a signal adds where more rows exist (form - none, on full and on short first pages), and what an
+    end signal saves on a real full last page (none - form); each form, and the main forms pooled
+    ("any signal": each item's mean over the forms).
+
+  uv run python scripts/cost_of_not_stopping.py data/processed/main.csv --out results/tables/main_cost.csv
+"""
+
+from __future__ import annotations
+
+import argparse
+
+import numpy as np
+import pandas as pd
+
+from fplp.analysis.common import analysis_sample, paired
+from fplp.analysis.hypotheses import MAIN_EXPLICIT, _cells
+
+MEASURES = ["n_calls", "followup_calls", "tokens_in"]
+LABEL = "descriptive (cost; not a registered or amended test)"
+
+
+def cost(scored: pd.DataFrame, seed: int = 0, n_boot: int = 2000) -> tuple[pd.DataFrame, pd.DataFrame]:
+    rng = np.random.default_rng(seed)
+    means, contrasts = [], []
+    for model, d in analysis_sample(scored).groupby("model"):
+        c = _cells(d, own_small_page=True)
+        cells = {"more rows exist, full page 1": c["need"], "more rows exist, short page 1": c["more_short"],
+                 "real full last page": c["last"]}
+        for cell_name, cell in cells.items():
+            for form, g in cell.groupby("signal_form"):
+                means.append({"model": model, "cell": cell_name, "form": form, "episodes": len(g),
+                              **{m: g[m].mean() for m in MEASURES}, "cap_hits": int(g["hit_cap"].sum())})
+            saving = cell_name == "real full last page"  # an end signal saves what no signal costs
+            pooled = cell[cell.signal_form.isin(MAIN_EXPLICIT)]
+            for form, side in [*((f, cell[cell.signal_form == f]) for f in MAIN_EXPLICIT), ("any signal", pooled)]:
+                none = cell[cell.signal_form == "none"]
+                for m in MEASURES:
+                    a, b = (none, side) if saving else (side, none)
+                    t = paired(a, b, m, rng, n_boot=n_boot)
+                    contrasts.append({"model": model, "cell": cell_name, "measure": m,
+                                      "contrast": f"none - {form}" if saving else f"{form} - none",
+                                      "reads_as": "saved by the end signal" if saving else "added by the signal",
+                                      **t, "label": LABEL})
+    return pd.DataFrame(means), pd.DataFrame(contrasts)
+
+
+def main(argv: list[str] | None = None) -> None:
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("scored_csv")
+    p.add_argument("--out", help="CSV of the paired contrasts; the per-form means go beside it (_means.csv)")
+    p.add_argument("--seed", type=int, default=0)
+    p.add_argument("--n-boot", type=int, default=2000)
+    args = p.parse_args(argv)
+    means, contrasts = cost(pd.read_csv(args.scored_csv), args.seed, args.n_boot)
+    with pd.option_context("display.width", 220, "display.max_rows", 400):
+        print(contrasts[contrasts["measure"] != "followup_calls"][["model", "cell", "measure", "contrast", "n", "diff", "lo", "hi"]]
+              .round(3).to_string(index=False))
+    if args.out:
+        contrasts.to_csv(args.out, index=False)
+        means.to_csv(args.out.replace(".csv", "_means.csv"), index=False)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/disclosure_labels.py b/scripts/disclosure_labels.py
new file mode 100644
index 0000000..3c7e0ef
--- /dev/null
+++ b/scripts/disclosure_labels.py
@@ -0,0 +1,261 @@
+"""Hand labels for the disclosure-flag validation, back from the two labelers (changelog, 25 Oct 2026).
+
+  convert   Check each returned labels file against its worksheet, then turn worksheet ids into episode ids.
+            The registered sample goes out in the format `fplp disclosure check` reads (`labels_a.csv`,
+            `labels_b.csv`: episode_id,label), the supplement with its parts and weights
+            (`supplement_labels.csv`), and every disagreement on the overlap, registered or not, in
+            `to_adjudicate.csv` (no flag, part or condition in it). Nothing is written if any check fails.
+  estimate  The supplement's weighted estimates. They are descriptive: the registered sample, through
+            `fplp disclosure check`, decides the 0.80 rule. The flag's precision is read on every flagged reply
+            (a census); its recall over incomplete answers counts missed disclosures in the census parts once
+            and scales those in the random parts by their weights (population / sampled), with a bootstrap
+            within the random parts; agreement is Cohen's kappa on the overlap.
+
+Supplement labels never go to `fplp disclosure check` or `fplp hypotheses`: those count every labeled reply
+unweighted, and the hand-label fallback would test H5 on an enriched sample.
+
+Usage:
+  uv run python scripts/disclosure_labels.py convert --dir REVIEW/disclosure --labels-a returned/A.csv \
+      --labels-b returned/B.csv --out-dir REVIEW/disclosure/returned [--adjudicated adjudicated.csv]
+  uv run fplp disclosure check REVIEW/disclosure/returned/labels_a.csv REVIEW/disclosure/returned/labels_b.csv \
+      data/raw/main --config configs/runs/main.yaml --out data/processed/disclosure_labels.csv \
+      [--adjudicated adjudicated.csv]
+  uv run python scripts/disclosure_labels.py estimate --dir REVIEW/disclosure --returned REVIEW/disclosure/returned \
+      --consensus data/processed/disclosure_labels.csv --out REVIEW/disclosure/returned/supplement_estimates.csv
+
+`adjudicated.csv` has columns episode_id,label, one row per disagreement listed in `to_adjudicate.csv`; the same
+file serves both commands.
+"""
+
+from __future__ import annotations
+
+import argparse
+import io
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+from statsmodels.stats.proportion import proportion_confint
+
+from fplp.analysis.disclosure import kappa
+
+LABELS = {"0": 0, "1": 1, "0.0": 0, "1.0": 1}  # a spreadsheet may write 1 as 1.0
+
+
+def read_labels(path: str | Path, ids: list[str], other_ids: list[str] | None = None,
+                ) -> tuple[pd.DataFrame, list[str], list[str]]:
+    """A returned labels file matched to its worksheet ids: columns by name, every id exactly once, every label 0
+    or 1. Returns the labels (wid, label, note), the problems (empty when the file can be used) and warnings."""
+    raw, warnings = Path(path).read_bytes(), []
+    try:
+        text = raw.decode("utf-8-sig")
+    except UnicodeDecodeError:
+        text = raw.decode("mac_roman")
+        warnings.append(f"{path}: not UTF-8, read as Mac Roman; ids and labels are ASCII, so only notes can be affected")
+    df = pd.read_csv(io.StringIO(text), dtype=str, keep_default_na=False)
+    df.columns = [str(c).strip().lower() for c in df.columns]
+    missing = [c for c in ("wid", "label") if c not in df.columns]
+    if missing:
+        return df, [f"{path}: no column named {', '.join(missing)} (columns: {', '.join(df.columns)})"], warnings
+    if "note" not in df.columns:
+        df["note"] = ""
+    df = df.assign(wid=df["wid"].str.strip(), label=df["label"].str.strip())
+    df = df[(df["wid"] != "") | (df["label"] != "")]  # trailing blank rows a spreadsheet adds
+    problems, known = [], set(ids)
+    if other_ids and set(df["wid"]) <= set(other_ids) and not set(df["wid"]) & known:
+        return df, [f"{path}: every id belongs to the other labeler's worksheet; the files may be swapped"], warnings
+    for what, bad in [("duplicated", sorted(set(df.loc[df["wid"].duplicated(), "wid"]))),
+                      ("not in the worksheet", sorted(set(df["wid"]) - known)),
+                      ("missing", sorted(known - set(df["wid"]))),
+                      ("with no label", sorted(df.loc[df["label"] == "", "wid"])),
+                      ("with a label other than 0 or 1",
+                       [f"{w}={v!r}" for w, v in zip(df["wid"], df["label"], strict=True) if v and v not in LABELS])]:
+        if bad:
+            problems.append(f"{path}: {len(bad)} id(s) {what}: {', '.join(bad[:12])}{' ...' if len(bad) > 12 else ''}")
+    if problems:
+        return df, problems, warnings
+    return df.assign(label=df["label"].map(LABELS))[["wid", "label", "note"]], [], warnings
+
+
+def read_adjudicated(path: str | Path | None) -> pd.Series:
+    if not path:
+        return pd.Series(dtype=float)
+    adj = pd.read_csv(path, dtype=str, keep_default_na=False)
+    adj.columns = [str(c).strip().lower() for c in adj.columns]
+    adj = adj.assign(episode_id=adj["episode_id"].str.strip(), label=adj["label"].str.strip())
+    bad = adj[~adj["label"].isin(LABELS)]
+    if len(bad) or adj["episode_id"].duplicated().any():
+        sys.exit(f"{path}: every row needs a unique episode_id and a label of 0 or 1")
+    return adj.set_index("episode_id")["label"].map(LABELS).astype(float)
+
+
+def merge(key: pd.DataFrame, a: pd.DataFrame, b: pd.DataFrame, adjudicated: pd.Series) -> pd.DataFrame:
+    """Every labeled reply with both labels and the consensus: labeler A's label, with labeler B's where they
+    overlap; agreement stands, a disagreement takes the adjudicated label (missing until adjudicated)."""
+    m = key.merge(a.rename(columns={"label": "label_a", "note": "note_a"}), on="wid", how="left")
+    m = m.merge(b.rename(columns={"wid": "wid_B", "label": "label_b", "note": "note_b"}), on="wid_B", how="left")
+    m["label"] = m["label_a"].where(m["label_b"].isna() | (m["label_a"] == m["label_b"]))
+    return m.assign(label=m["label"].fillna(m["episode_id"].map(adjudicated)))
+
+
+def cmd_convert(args) -> None:
+    d = Path(args.dir)
+    key = pd.read_csv(d / "key.csv", dtype={"wid": str, "wid_B": str, "episode_id": str})
+    sheets = {who: pd.read_csv(d / f"for-labeler-{who}" / "worksheet.csv", dtype=str) for who in "AB"}
+    problems = []
+    if set(sheets["A"]["wid"]) != set(key["wid"]):
+        problems.append("labeler A's worksheet ids differ from the key's")
+    if set(sheets["B"]["wid"]) != set(key["wid_B"].dropna()):
+        problems.append("labeler B's worksheet ids differ from the key's")
+    inputs = d / "inputs"
+    if (inputs / "disclosure_to_label.csv").exists():  # the registered draw, as `fplp disclosure sample` wrote it
+        reg = set(pd.read_csv(inputs / "disclosure_to_label.csv", dtype=str)["episode_id"])
+        reg2 = set(pd.read_csv(inputs / "disclosure_to_label_second.csv", dtype=str)["episode_id"])
+        r = key[key["part"] == "R"]
+        if set(r["episode_id"]) != reg or set(r.loc[r["wid_B"].notna(), "episode_id"]) != reg2:
+            problems.append("the key's registered part differs from the registered draw in inputs/")
+    a, pa, wa = read_labels(args.labels_a, list(sheets["A"]["wid"]), list(sheets["B"]["wid"]))
+    b, pb, wb = read_labels(args.labels_b, list(sheets["B"]["wid"]), list(sheets["A"]["wid"]))
+    for line in wa + wb:
+        print("note:", line)
+    problems += pa + pb
+    if problems:
+        sys.exit("Not converted; nothing written:\n  " + "\n  ".join(problems))
+    adjudicated = read_adjudicated(args.adjudicated)
+    m = merge(key, a, b, adjudicated)
+    m[["label_a", "label_b", "label"]] = m[["label_a", "label_b", "label"]].astype("Int64")  # 1, not 1.0, in the files
+    overlap = m[m["label_b"].notna()]
+    split = overlap["label_a"] != overlap["label_b"]
+    stray = sorted(set(adjudicated.index) - set(overlap.loc[split, "episode_id"]))
+    if stray:
+        sys.exit(f"{args.adjudicated}: {len(stray)} episode id(s) that are not disagreements: {', '.join(stray[:12])}")
+    out = Path(args.out_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    reg = m[m["part"] == "R"]
+    reg[["episode_id", "label_a"]].rename(columns={"label_a": "label"}).to_csv(out / "labels_a.csv", index=False)
+    reg.loc[reg["label_b"].notna(), ["episode_id", "label_b"]].rename(columns={"label_b": "label"}).to_csv(
+        out / "labels_b.csv", index=False)
+    sup_cols = ["wid", "wid_B", "episode_id", "part", "population", "sampled", "weight", "model", "answer_format",
+                "evidence_seen", "disclosure_flag", "label_a", "label_b", "label"]
+    m.loc[m["part"] != "R", sup_cols].to_csv(out / "supplement_labels.csv", index=False)
+    text = sheets["A"].set_index("wid")[["question", "reply"]]
+    disagree = overlap[split].join(text, on="wid")
+    disagree[["episode_id", "wid", "wid_B", "question", "reply", "label_a", "label_b", "note_a", "note_b"]].assign(
+        adjudicated=disagree["episode_id"].map(adjudicated)).to_csv(out / "to_adjudicate.csv", index=False)
+    print(f"labeler A: {len(a)} labels, {int(a['label'].sum())} marked 1; labeler B: {len(b)}, {int(b['label'].sum())}")
+    for name, g in [("registered overlap", overlap[overlap["part"] == "R"]),
+                    ("supplement overlap", overlap[overlap["part"] != "R"]), ("all overlap", overlap)]:
+        print(f"{name}: {len(g)} replies, {int((g['label_a'] != g['label_b']).sum())} disagreement(s), "
+              f"kappa = {kappa(g['label_a'], g['label_b']):.3f}")
+    left = int(m["label"].isna().sum())
+    print(f"{int(split.sum())} disagreement(s) -> {out / 'to_adjudicate.csv'}; {left} not yet adjudicated")
+    print(f"registered sample: {len(reg)} replies -> {out / 'labels_a.csv'}, "
+          f"{int(reg['label_b'].notna().sum())} -> {out / 'labels_b.csv'} (for `fplp disclosure check`)")
+    print(f"supplement: {int((m['part'] != 'R').sum())} replies -> {out / 'supplement_labels.csv'} (for `estimate` only)")
+
+
+def wilson(k: int, n: int) -> tuple[float, float]:
+    return tuple(float(x) for x in proportion_confint(k, n, method="wilson")) if n else (np.nan, np.nan)
+
+
+def recall_parts(rows: pd.DataFrame) -> tuple[np.ndarray, np.ndarray]:
+    """Per reply, its weight if it is a disclosed incomplete answer the flag marked (true positive) or missed."""
+    disclosed = ((rows["evidence_seen"] == 0) & (rows["label"] == 1)).to_numpy() * rows["w"].to_numpy()
+    flag = (rows["disclosure_flag"] == 1).to_numpy()
+    return disclosed * flag, disclosed * ~flag
+
+
+def estimate(rows: pd.DataFrame, n_boot: int = 10_000, seed: int = 0) -> list[dict]:
+    """rows: every labeled reply (registered and supplement) with part, w (1 for a census or the registered sample,
+    population / sampled for a random part), evidence_seen, disclosure_flag, label (consensus) and model."""
+    out = []
+    flagged = rows[rows["disclosure_flag"] == 1]
+    if (flagged["w"] != 1).any():
+        sys.exit("a flagged reply has a weight other than 1; precision assumes every flagged reply is labeled")
+    for scope, g in [("every flagged reply", flagged), ("flagged incomplete answers", flagged[flagged["evidence_seen"] == 0])]:
+        k, n = int(g["label"].sum()), len(g)
+        lo, hi = wilson(k, n)
+        out.append({"quantity": "precision", "scope": scope, "model": "all", "value": k / n if n else np.nan,
+                    "lo": lo, "hi": hi, "n": n, "interval": "Wilson 95%"})
+    random_parts = [p for p, g in rows.groupby("part") if (g["w"] != 1).any()]
+    rng = np.random.default_rng(seed)
+    for model in ["all", *sorted(rows["model"].unique())]:
+        g = rows if model == "all" else rows[rows["model"] == model]
+        tp_i, fn_i = recall_parts(g)
+        tp, fn = float(tp_i.sum()), float(fn_i.sum())
+        # Census parts and the registered sample are fixed; each random part is resampled within itself.
+        fixed = ~g["part"].isin(random_parts).to_numpy()
+        btp, bfn = np.full(n_boot, tp_i[fixed].sum()), np.full(n_boot, fn_i[fixed].sum())
+        for part in random_parts:
+            idx = np.flatnonzero((g["part"] == part).to_numpy())
+            if len(idx):
+                draw = idx[rng.integers(0, len(idx), (n_boot, len(idx)))]
+                btp, bfn = btp + tp_i[draw].sum(axis=1), bfn + fn_i[draw].sum(axis=1)
+        with np.errstate(invalid="ignore", divide="ignore"):
+            boot = btp / (btp + bfn)
+        defined = boot[np.isfinite(boot)]
+        lo, hi = np.percentile(defined, [2.5, 97.5]) if len(defined) else (np.nan, np.nan)
+        incomplete = float(g.loc[g["evidence_seen"] == 0, "w"].sum())
+        n_inc = int((g["evidence_seen"] == 0).sum())
+        out.append({"quantity": "recall, incomplete answers", "scope": f"true positives {tp:g}, missed (weighted) {fn:.1f}",
+                    "model": model, "value": tp / (tp + fn) if tp + fn else np.nan, "lo": lo, "hi": hi, "n": n_inc,
+                    "interval": f"bootstrap 95% within {', '.join(random_parts) or 'no random part'}; "
+                    f"{1 - len(defined) / n_boot:.1%} of replicates undefined"})
+        out.append({"quantity": "disclosures among incomplete answers (weighted)", "scope": f"of {incomplete:.0f}",
+                    "model": model, "value": tp + fn, "lo": np.nan, "hi": np.nan, "n": n_inc, "interval": ""})
+    return out
+
+
+def cmd_estimate(args) -> None:
+    key = pd.read_csv(Path(args.dir) / "key.csv", dtype={"wid": str, "wid_B": str, "episode_id": str})
+    sup = pd.read_csv(Path(args.returned) / "supplement_labels.csv", dtype={"episode_id": str})
+    cons = pd.read_csv(args.consensus, dtype={"episode_id": str})  # `fplp disclosure check` output
+    reg = key[key["part"] == "R"].merge(cons[["episode_id", "label_a", "label_b", "label"]], on="episode_id", how="left")
+    if len(cons) != len(reg) or set(cons["episode_id"]) != set(reg["episode_id"]):
+        sys.exit(f"{args.consensus} does not hold exactly the registered sample's {len(reg)} replies")
+    rows = pd.concat([reg.assign(w=1.0), sup.assign(w=sup["weight"].astype(float))], ignore_index=True)
+    left = rows[rows["label"].isna()]
+    if len(left):
+        sys.exit(f"{len(left)} disagreement(s) not yet adjudicated ({', '.join(left['episode_id'][:12])}); "
+                 "adjudicate them first, then rerun convert and `fplp disclosure check` with --adjudicated")
+    rows["label"] = rows["label"].astype(int)
+    res = pd.DataFrame(estimate(rows, args.n_boot, args.seed))
+    overlap = rows[rows["label_b"].notna()]
+    for name, g in [("registered", overlap[overlap["part"] == "R"]), ("supplement", overlap[overlap["part"] != "R"]),
+                    ("all", overlap)]:
+        res.loc[len(res)] = {"quantity": "kappa between labelers", "scope": f"{name} overlap", "model": "all",
+                             "value": kappa(g["label_a"], g["label_b"]), "lo": np.nan, "hi": np.nan, "n": len(g),
+                             "interval": ""}
+    with pd.option_context("display.width", 200, "display.max_colwidth", 80):
+        print("Supplement estimates (descriptive; the registered check decides the 0.80 rule):")
+        print(res.round(3).to_string(index=False))
+    if args.out:
+        res.to_csv(args.out, index=False)
+        print(f"-> {args.out}")
+
+
+def main(argv: list[str] | None = None) -> None:
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = p.add_subparsers(dest="cmd", required=True)
+    c = sub.add_parser("convert")
+    c.add_argument("--dir", required=True, help="the folder with key.csv, inputs/ and the labelers' worksheets")
+    c.add_argument("--labels-a", required=True)
+    c.add_argument("--labels-b", required=True)
+    c.add_argument("--out-dir", required=True)
+    c.add_argument("--adjudicated")
+    c.set_defaults(func=cmd_convert)
+    e = sub.add_parser("estimate")
+    e.add_argument("--dir", required=True)
+    e.add_argument("--returned", required=True, help="convert's output folder")
+    e.add_argument("--consensus", required=True, help="`fplp disclosure check` output for the registered sample")
+    e.add_argument("--out")
+    e.add_argument("--n-boot", type=int, default=10_000)
+    e.add_argument("--seed", type=int, default=0)
+    e.set_defaults(func=cmd_estimate)
+    args = p.parse_args(argv)
+    args.func(args)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/disclosure_worksheet.py b/scripts/disclosure_worksheet.py
new file mode 100644
index 0000000..2f25827
--- /dev/null
+++ b/scripts/disclosure_worksheet.py
@@ -0,0 +1,157 @@
+"""Blinded labeling worksheets for the disclosure-flag validation: the registered sample plus the supplement that
+lets the flag's precision and recall be estimated (changelog, 25 Oct 2026; the supplement is descriptive only).
+
+The registered sample is `fplp disclosure sample`'s draw, unchanged (`--registered`, `--registered-second`).
+The supplement adds, from the main study's needs-all replies outside the registered sample (retests left out,
+as the registered sampler does):
+  F  every reply the flag marks (census): precision;
+  W  every incomplete final-line reply the flag missed that the registered wide-net screen (`fplp disclosure
+     screen`, amendment 2) caught (census): the likeliest missed disclosures;
+  U  a seeded random sample of the other incomplete final-line replies the flag missed;
+  C  a seeded random sample of the incomplete completeness-format replies the flag missed (their prose,
+     without the COMPLETENESS line, is what H5b's prose part reads).
+Each supplement reply carries its sampling weight (population / sampled; 1 for a census), so missed disclosures
+can be estimated over the whole population. Labelers see only a worksheet id, the question and the reply
+without its COMPLETENESS line, shuffled; the key (`key.csv`) holds everything else and is not for labelers.
+Labeler A gets every reply; labeler B gets the registered overlap of 100 plus a stratified overlap of the
+supplement, reshuffled with new ids. Label files are never overwritten. `scripts/disclosure_labels.py` reads
+the returned labels.
+
+  uv run python scripts/disclosure_worksheet.py --scored data/processed/main.csv --raw data/raw/main \
+      --registered data/processed/disclosure_to_label.csv --registered-second data/processed/disclosure_to_label_second.csv \
+      --screen data/processed/disclosure_screen.csv --out-dir REVIEW/disclosure
+"""
+
+from __future__ import annotations
+
+import argparse
+import html
+import json
+import random
+from pathlib import Path
+
+import pandas as pd
+
+from fplp.metrics import _episode_files, _read_records, prose
+
+CONDITION = ["arm", "signal_form", "conflict", "extent", "task_type", "answer_format", "documented"]
+
+
+def population(scored: pd.DataFrame) -> pd.DataFrame:
+    """Needs-all replies the registered sampler draws from: no empty reply, no refusal, no retest."""
+    keep = (scored["task_need"] == "needs_all") & (scored["empty_reply"] == 0) & (scored["arm"] != "retest")
+    if "stop_reason" in scored:
+        keep &= scored["stop_reason"] != "refusal"
+    return scored[keep]
+
+
+def supplement(scored: pd.DataFrame, registered: set[str], screen: set[str], n_u: int, n_c: int, seed: int) -> pd.DataFrame:
+    pop = population(scored)
+    out = pop[~pop["episode_id"].isin(registered)]
+    missed = (out["evidence_seen"] == 0) & (out["disclosure_flag"] == 0)
+    strata = {
+        "F": out[out["disclosure_flag"] == 1],
+        "W": out[missed & (out["answer_format"] == "final_line") & out["episode_id"].isin(screen)],
+        "U": out[missed & (out["answer_format"] == "final_line") & ~out["episode_id"].isin(screen)],
+        "C": out[missed & (out["answer_format"] == "completeness")],
+    }
+    rng = random.Random(f"{seed}:disclosure-supplement")
+    parts = []
+    for name, frame in strata.items():
+        ids = sorted(frame["episode_id"])
+        n = {"U": n_u, "C": n_c}.get(name, len(ids))
+        drawn = ids if n >= len(ids) else rng.sample(ids, n)
+        parts.append(frame[frame["episode_id"].isin(drawn)].assign(part=name, population=len(ids), sampled=len(drawn),
+                                                                     weight=len(ids) / max(len(drawn), 1)))
+    return pd.concat(parts, ignore_index=True)
+
+
+STYLE = ("body{font:15px/1.5 -apple-system,sans-serif;max-width:900px;margin:0 auto;padding:24px 16px}"
+         "section{border:1px solid #ccc;border-radius:8px;padding:12px 14px;margin:14px 0}"
+         "pre{white-space:pre-wrap;word-break:break-word;font:13px/1.45 ui-monospace,Menlo,monospace;background:#f6f6f8;"
+         "padding:10px;border-radius:6px}"
+         "@media (prefers-color-scheme:dark){body{background:#161618;color:#ececf0}pre{background:#222}section{border-color:#444}}")
+
+
+def worksheet_html(view: pd.DataFrame, title: str) -> str:
+    e = html.escape
+    parts = [(f"<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' "
+              f"content='width=device-width, initial-scale=1'><title>{e(title)}</title><style>{STYLE}</style></head><body>"),
+             (f"<h1>{e(title)}</h1><p>Label each reply in the labels file (worksheet id, label, note): <b>1</b> if the reply "
+              "says or implies the answer may be incomplete, <b>0</b> if not. See the instructions file.</p>")]
+    for _, r in view.iterrows():
+        parts.append(f"<section id='{e(r['wid'])}'><h2>{e(r['wid'])}</h2><p><b>Question:</b> {e(r['question'])}</p>"
+                     f"<pre>{e(r['reply'])}</pre></section>")
+    parts.append("</body></html>")
+    return "\n".join(parts)
+
+
+def write_blank(path: Path, wids: list[str]) -> str:
+    if path.exists():  # never overwrite labels already entered
+        return f"kept the existing {path}"
+    pd.DataFrame({"wid": wids, "label": "", "note": ""}).to_csv(path, index=False)
+    return f"wrote {path}"
+
+
+def main(argv: list[str] | None = None) -> None:
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("--scored", required=True)
+    p.add_argument("--raw", nargs="+", required=True)
+    p.add_argument("--registered", required=True)
+    p.add_argument("--registered-second", required=True)
+    p.add_argument("--screen", required=True)
+    p.add_argument("--out-dir", required=True)
+    p.add_argument("--n-random-final", type=int, default=120)
+    p.add_argument("--n-random-completeness", type=int, default=60)
+    p.add_argument("--second-supplement", default="F:10,W:25,U:15", help="labeler B's overlap of the supplement, per part")
+    p.add_argument("--seed", type=int, default=20261025)
+    args = p.parse_args(argv)
+    scored = pd.read_csv(args.scored)
+    reg, reg2 = pd.read_csv(args.registered), pd.read_csv(args.registered_second)
+    screen = set(pd.read_csv(args.screen)["episode_id"])
+    sup = supplement(scored, set(reg["episode_id"]), screen, args.n_random_final, args.n_random_completeness, args.seed)
+    records, _ = _read_records(_episode_files(args.raw))
+    text = {r["episode_id"]: (r["question"], prose(r["final_text"]).strip()) for r in records}
+    reg_part = scored[scored["episode_id"].isin(reg["episode_id"])].assign(part="R", population=pd.NA, sampled=pd.NA, weight=pd.NA)
+    allrows = pd.concat([reg_part, sup], ignore_index=True)
+    allrows[["question", "reply"]] = [text[e] for e in allrows["episode_id"]]
+    # Labeler A: every reply, shuffled, new ids.
+    order = list(allrows.index)
+    random.Random(f"{args.seed}:labeler-A").shuffle(order)
+    a = allrows.loc[order].reset_index(drop=True)
+    a["wid"] = [f"A{i:03d}" for i in range(1, len(a) + 1)]
+    # Labeler B: the registered overlap plus a stratified overlap of the supplement, reshuffled, new ids.
+    rng = random.Random(f"{args.seed}:labeler-B")
+    quota = {k: int(v) for k, v in (x.split(":") for x in args.second_supplement.split(","))}
+    pick = list(reg2["episode_id"])
+    for part, n in quota.items():
+        ids = sorted(sup.loc[sup["part"] == part, "episode_id"])
+        pick += ids if n >= len(ids) else rng.sample(ids, n)
+    rng.shuffle(pick)
+    b = a.set_index("episode_id").loc[pick].reset_index()
+    b["wid_B"] = [f"B{i:03d}" for i in range(1, len(b) + 1)]
+    a = a.merge(b[["episode_id", "wid_B"]], on="episode_id", how="left")
+    out = Path(args.out_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    key_cols = ["wid", "wid_B", "episode_id", "part", "population", "sampled", "weight", "model", *CONDITION, "evidence_seen",
+                "disclosure_flag", "disclosure_stratum", "stated_completeness"]
+    a[key_cols].to_csv(out / "key.csv", index=False)
+    for who, view, wcol in (("A", a, "wid"), ("B", b, "wid_B")):
+        # Each labeler's folder holds only what that labeler may see; the key and inputs stay outside it.
+        folder = out / f"for-labeler-{who}"
+        folder.mkdir(exist_ok=True)
+        v = view[[wcol, "question", "reply"]].rename(columns={wcol: "wid"})
+        v.to_csv(folder / "worksheet.csv", index=False)
+        (folder / "worksheet.html").write_text(worksheet_html(v, f"Disclosure labels, labeler {who} ({len(v)} replies)"))
+        print(write_blank(folder / "labels.csv", list(v["wid"])))
+    counts = a.groupby("part").agg(replies=("episode_id", "size"), population=("population", "first"), in_B=("wid_B", "count"))
+    print(counts.to_string())
+    print(f"labeler A: {len(a)} replies; labeler B: {len(b)} replies -> {out}")
+    (out / "manifest.json").write_text(json.dumps({"seed": args.seed, "n_random_final": args.n_random_final,
+                                                   "n_random_completeness": args.n_random_completeness,
+                                                   "second_supplement": quota, "labeler_A": len(a), "labeler_B": len(b),
+                                                   "parts": counts.reset_index().astype(str).to_dict(orient="records")}, indent=1))
+
+
+if __name__ == "__main__":
+    main()
