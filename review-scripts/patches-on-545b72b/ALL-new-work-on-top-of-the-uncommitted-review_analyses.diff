+            rec.update(episode_id=f"e{i}", model="a" if i < 3 else "b", final_text="FINAL ANSWER: 1")
+            fh.write(json.dumps(rec) + "\n")
+    samples = []
+    for part, eids in ((1, ["e0", "e1", "e2"]), (2, ["e3", "e4"])):
