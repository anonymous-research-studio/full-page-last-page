+"""The disclosure-validation worksheet builder (scripts/disclosure_worksheet.py)."""
+
+import importlib.util
+from pathlib import Path
+
+import pandas as pd
+
+_SPEC = importlib.util.spec_from_file_location(
+    "disclosure_worksheet", Path(__file__).resolve().parents[1] / "scripts" / "disclosure_worksheet.py")
+dw = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(dw)
+
+
+def _scored() -> pd.DataFrame:
+    rows = [{"episode_id": f"e{i}", "model": "m", "task_need": "needs_all", "empty_reply": 0, "arm": "core",
+             "answer_format": "completeness" if i % 4 == 0 else "final_line", "evidence_seen": int(i % 3 == 0),
+             "disclosure_flag": int(i in (5, 7)), "stop_reason": "stop"} for i in range(60)]
+    rows.append({**rows[1], "episode_id": "r1", "arm": "retest"})          # retests are left out
+    rows.append({**rows[1], "episode_id": "p1", "task_need": "page1_sufficient"})
+    return pd.DataFrame(rows)
+
+
+def test_supplement_parts_weights_and_exclusions():
+    scored = _scored()
+    registered = {"e1", "e2"}
+    screen = {"e4", "e8", "e10"}
+    sup = dw.supplement(scored, registered, screen, n_u=5, n_c=3, seed=1)
+    assert not set(sup["episode_id"]) & (registered | {"r1", "p1"})
+    assert set(sup.loc[sup["part"] == "F", "episode_id"]) == {"e5", "e7"}
+    w = sup[sup["part"] == "W"]
+    assert set(w["episode_id"]) <= screen and (w["weight"] == 1).all()
+    for part, n in (("U", 5), ("C", 3)):
+        s = sup[sup["part"] == part]
+        assert len(s) == n and (s["weight"] == s["population"] / n).all()
+        assert (s["disclosure_flag"] == 0).all() and (s["evidence_seen"] == 0).all()
+    again = dw.supplement(scored, registered, screen, n_u=5, n_c=3, seed=1)
+    assert list(again["episode_id"]) == list(sup["episode_id"])
+
+
+def test_worksheet_shows_only_id_question_reply_and_labels_are_kept(tmp_path):
+    view = pd.DataFrame({"wid": ["A001"], "question": ["How many?"], "reply": ["FINAL ANSWER: 3 <b>"]})
+    page = dw.worksheet_html(view, "t")
+    assert "A001" in page and "&lt;b&gt;" in page and "disclosure_flag" not in page and "{{" not in page
+    labels = tmp_path / "labels.csv"
+    assert dw.write_blank(labels, ["A001"]).startswith("wrote")
+    labels.write_text("wid,label,note\nA001,1,x\n")
+    assert dw.write_blank(labels, ["A001"]).startswith("kept") and "A001,1,x" in labels.read_text()
diff --git a/tests/test_edge_cases.py b/tests/test_edge_cases.py
new file mode 100644
index 0000000..1ac1e26
--- /dev/null
+++ b/tests/test_edge_cases.py
@@ -0,0 +1,117 @@
+"""Fetch edge-case counts and the two post hoc categories (scripts/edge_cases.py)."""
+
+import importlib.util
+from dataclasses import asdict
+from pathlib import Path
+
+from fplp.env.server import MockAPI
+from fplp.signals.formats import Conflict, Extent
+from fplp.tasks.specs import build_episode
+
+_spec = importlib.util.spec_from_file_location("edge_cases", Path(__file__).parents[1] / "scripts" / "edge_cases.py")
+edge_cases = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(edge_cases)
+
+
+def _episode(condition, turns):
+    """Serve each turn's calls on the target query (a callable gets the calls so far) and build the record."""
+    spec = build_episode(condition)
+    api = MockAPI(spec)
+    for turn, calls in enumerate(turns, start=1):
+        for args in calls:
+            args = args(api.calls) if callable(args) else args
+            api.call(spec.target_tool, {**spec.target_args, **args})
+            api.calls[-1]["turn"] = turn
+    return {"episode_id": "t", "model": "m", "condition": condition.to_dict(), "calls": api.calls,
+            "n_items": len(spec.rows), "gold": asdict(spec.gold)}
+
+
+def _listed(rec):
+    return [(x["category"], x["argument"], x["end_signal"], x["outcome"]) for x in edge_cases.episode_edges(rec)[1]]
+
+
+def test_an_ordinary_cursor_follow_up_is_in_neither_category(make_condition):
+    rec = _episode(make_condition("next_cursor", "filtered_count", 0),
+                   [[{}], [lambda calls: {"cursor": edge_cases.issued_cursors(calls[-1]["output"]).pop()}]])
+    edges, listed = edge_cases.episode_edges(rec)
+    assert rec["calls"][1]["error"] is None and listed == []
+    assert edges == {"placeholder_cursor_first_turn": 0, "first_limit_above_page_limit": 0, "parallel_calls": 0,
+                     "parallel_target_calls": 0, "no_successful_target_call": 0, "offset_outside_schema": 0}
+
+
+def test_paging_after_a_page_that_said_more_is_in_neither_category(make_condition):
+    assert _listed(_episode(make_condition("has_more", "filtered_count", 0), [[{}], [{"page": 2}]])) == []
+
+
+def test_an_order_id_used_as_a_cursor_is_an_invented_value(make_condition):
+    rec = _episode(make_condition("has_more", "filtered_count", 0), [[{}], [{"cursor": "ORD-90780"}]])
+    listed = edge_cases.episode_edges(rec)[1]
+    assert [(x["category"], x["turn"], x["previous_page_showed"], x["outcome"]) for x in listed] == \
+        [("invented value", 2, "more", "error: invalid cursor")]
+
+
+def test_page_two_after_a_null_cursor_on_a_real_last_page_is_a_re_check(make_condition):
+    rec = _episode(make_condition("next_cursor", "filtered_count", 0, extent=Extent.LAST_FULL), [[{}], [{"page": 2}]])
+    assert _listed(rec) == [("re-check after an end signal", "page", "true", "empty")]
+
+
+def test_page_two_after_a_false_end_is_a_re_check_that_returns_rows(make_condition):
+    rec = _episode(make_condition("has_more", "filtered_count", 0, conflict=Conflict.FALSE_END), [[{}], [{"page": 2}]])
+    assert _listed(rec) == [("re-check after an end signal", "page", "false", "rows")]
+
+
+def test_a_false_end_contradicted_on_the_page_is_marked(make_condition):
+    rec = _episode(make_condition("has_more", "filtered_count", 0, conflict=Conflict.VISIBLE_TOTAL), [[{}], [{"page": 2}]])
+    listed = edge_cases.episode_edges(rec)[1]
+    assert [(x["end_signal"], x["contradicted_on_page"], x["outcome"]) for x in listed] == [("false", True, "rows")]
+
+
+def test_offset_is_in_no_schema_so_it_is_only_a_schema_check(make_condition):
+    rec = _episode(make_condition("next_cursor", "filtered_count", 0, extent=Extent.LAST_FULL), [[{}], [{"offset": 20}]])
+    edges, listed = edge_cases.episode_edges(rec)
+    assert edges["offset_outside_schema"] == 1 and listed == []
+
+
+def test_page_is_offered_in_documented_and_undocumented_schemas(make_condition):
+    for documented in (True, False):
+        c = make_condition("none", "filtered_count", 0, documented=documented).to_dict()
+        offered = edge_cases._offered({"limit_stated": True, "doc_wording": "default", **c}, "list_orders")
+        assert {"page", "cursor", "limit"} <= offered and "offset" not in offered
+
+
+def test_first_turn_edge_cases(make_condition):
+    rec = _episode(make_condition("next_cursor", "filtered_count", 0), [[{"limit": 50}, {"cursor": "null"}]])
+    edges, listed = edge_cases.episode_edges(rec)
+    assert edges["placeholder_cursor_first_turn"] == 1 and edges["first_limit_above_page_limit"] == 1
+    assert edges["parallel_calls"] == 1 and edges["parallel_target_calls"] == 1
+    assert [(x["category"], x["previous_page_showed"]) for x in listed] == [("invented value", "no page read yet")]
+
+
+def test_no_successful_target_call(make_condition):
+    edges, _ = edge_cases.episode_edges(_episode(make_condition("has_more", "filtered_count", 0), [[{"page": 0}]]))
+    assert edges["no_successful_target_call"] == 1
+
+
+def test_rates_use_the_episodes_that_read_each_end_as_denominators(make_condition):
+    last = make_condition("next_cursor", "filtered_count", 0, extent=Extent.LAST_FULL)
+    recs = [_episode(last, [[{}], [{"page": 2}]]), _episode(last, [[{}]]),  # both read a true end; one re-checks
+            _episode(make_condition("has_more", "filtered_count", 1, conflict=Conflict.FALSE_END), [[{}], [{"page": 2}]]),
+            _episode(make_condition("has_more", "filtered_count", 2), [[{}], [{"cursor": "ORD-1"}]])]
+    for i, r in enumerate(recs):
+        r["episode_id"] = f"e{i}"
+    r = edge_cases.rates(recs)
+    pooled = r[(r["arm"] == "all")].set_index("measure")
+    assert (pooled.loc["re-check after a true end", ["k", "n"]] == [1, 2]).all()
+    assert (pooled.loc["re-check that returned rows after a true end", ["k", "n"]] == [0, 2]).all()
+    assert (pooled.loc["re-check after a false end", ["k", "n"]] == [1, 1]).all()
+    assert (pooled.loc["re-check that returned rows after a false end", ["k", "n"]] == [1, 1]).all()
+    assert (pooled.loc["invented value", ["k", "n"]] == [1, 4]).all()
+    assert set(r["label"]) == {"post hoc, descriptive"}
+
+
+def test_cursors_are_read_from_every_cursor_field():
+    assert edge_cases.issued_cursors('{"results": [], "next_cursor": "abc"}') == {"abc"}
+    assert edge_cases.issued_cursors('{"pageInfo": {"hasNextPage": true, "endCursor": "x_y-z"}}') == {"x_y-z"}
+    link = '{"headers": {"Link": "<https://api.example.com/v1/orders?customer=A&cursor=t%2Bk&limit=20>; rel=\\"next\\""}}'
+    assert edge_cases.issued_cursors(link) == {"t+k"}
+    assert edge_cases.issued_cursors('{"results": [{"order_id": "ORD-90780"}], "has_more": true}') == set()
diff --git a/tests/test_scoring_pieces.py b/tests/test_scoring_pieces.py
new file mode 100644
index 0000000..de92e2f
--- /dev/null
+++ b/tests/test_scoring_pieces.py
@@ -0,0 +1,122 @@
+"""The completion-time cutoff, per-model duplicate counts and the second scoring (24 Oct audit fixes)."""
+
+from dataclasses import asdict
+from datetime import datetime
+
+from fplp.agents.scripted import ScriptedClient
+from fplp.env.server import MockAPI
+from fplp.episode import run_episode
+from fplp.metrics import score_episode, select_records
+from fplp.signals.formats import Extent
+from fplp.tasks.specs import build_episode
+
+
+def _record(condition, spec, calls, final="FINAL ANSWER: 1"):
+    return {"episode_id": "t", "model": "m", "condition": condition.to_dict(), "calls": calls, "n_items": len(spec.rows),
+            "first_page_size": spec.first_page_size, "gold": asdict(spec.gold), "final_text": final,
+            "hit_cap": False, "stop_reason": "end_turn", "tokens_in": 0, "tokens_out": 0}
+
+
+def _api_calls(spec, args_by_turn):
+    """Serve the given calls, turn by turn, and stamp each logged call with its turn."""
+    api = MockAPI(spec)
+    for turn, calls in enumerate(args_by_turn, start=1):
+        for args in calls:
+            api.call(spec.target_tool, {**spec.target_args, **args})
+            api.calls[-1]["turn"] = turn
+    return api.calls
+
+
+def _minimal(eid, model, finished_at):
+    return {"episode_id": eid, "model": model, "finished_at": finished_at, "condition": {"task_type": "filtered_count"}}
+
+
+def test_cutoff_drops_late_episodes_per_model_and_keeps_undated_ones():
+    recs = [_minimal("a", "m1", "2026-10-25T20:59:59+00:00"), _minimal("b", "m1", "2026-10-25T21:00:00.5+00:00"),
+            _minimal("c", "m2", "2026-10-25T21:00:00+00:00"), {**_minimal("d", "m2", None)}]
+    kept, report = select_records(recs, None, cutoff=datetime.fromisoformat("2026-10-25T17:00:00-04:00"))
+    assert [r["episode_id"] for r in kept] == ["a", "c", "d"]  # 17:00:00 EDT itself is in
+    assert "m1: dropped 1 episode(s) finished after the cutoff 2026-10-25T17:00:00-04:00" in report
+    assert "m2: dropped 0 episode(s) finished after the cutoff 2026-10-25T17:00:00-04:00" in report
+    assert "WARNING m2: 1 episode(s) have no completion time; kept" in report
+
+
+def test_duplicates_are_counted_per_model_and_the_first_is_kept():
+    first, again = _minimal("a", "m1", "2026-10-25T01:00:00+00:00"), _minimal("a", "m1", "2026-10-25T02:00:00+00:00")
+    kept, report = select_records([first, again, _minimal("b", "m2", "2026-10-25T01:00:00+00:00")], None)
+    assert kept[0] is first and len(kept) == 2
+    assert report == ["m1: dropped 1 duplicate record(s) (same episode id; the first was kept)"]
+
+
+def test_no_cutoff_and_no_duplicates_reports_nothing_new():
+    kept, report = select_records([_minimal("a", "m1", "2026-10-25T01:00:00+00:00")], None)
+    assert len(kept) == 1 and report == []
+
+
+def test_fixes_change_nothing_on_an_ordinary_episode(make_condition):
+    rec = run_episode(ScriptedClient("f", "follow_all"), build_episode(make_condition("has_more", "filtered_count", 0)),
+                      max_tool_calls=12)
+    rec["episode_id"] = "t"
+    frozen, fixed = score_episode(rec), score_episode(rec, fixes=True)
+    assert {k: fixed[k] for k in frozen} == frozen
+    assert (fixed["requested_limit_raw"], fixed["asked_above_limit"], fixed["no_target_page"],
+            fixed["stratum_post_hoc"]) == (None, 0, 0, None)
+
+
+def test_first_turn_placeholder_cursor_is_not_a_fetch_under_the_fixes(make_condition):
+    c = make_condition("next_cursor", "filtered_count", 0, extent=Extent.LAST_FULL)
+    spec = build_episode(c)
+    rec = _record(c, spec, _api_calls(spec, [[{}, {"cursor": "null"}]]))
+    assert rec["calls"][1]["error"] == "invalid cursor"
+    frozen, fixed = score_episode(rec), score_episode(rec, fixes=True)
+    assert (frozen["follow_up"], frozen["speculative_fetch"], frozen["extra_fetch"]) == (1, 1, 1)
+    assert (fixed["follow_up"], fixed["speculative_fetch"], fixed["extra_fetch"]) == (0, 0, 0)
+
+
+def test_invented_cursor_after_page_one_is_still_a_fetch(make_condition):
+    c = make_condition("has_more", "filtered_count", 0)
+    spec = build_episode(c)
+    rec = _record(c, spec, _api_calls(spec, [[{}], [{"cursor": "ORD-90780"}]]))
+    assert score_episode(rec, fixes=True)["follow_up"] == 1  # a paging attempt after reading page 1
+
+
+def test_no_target_page_has_no_amendment_1_stratum(make_condition):
+    c = make_condition("has_more", "filtered_count", 0)
+    spec = build_episode(c)
+    rec = _record(c, spec, _api_calls(spec, [[{"page": 0}]]))
+    assert score_episode(rec)["disclosure_stratum"] == "warranted"
+    fixed = score_episode(rec, fixes=True)
+    assert fixed["disclosure_stratum"] is None and fixed["no_target_page"] == 1
+    assert fixed["stratum_post_hoc"] == "no_page_served"  # descriptive, post hoc
+
+
+def test_full_no_signal_page_on_a_last_extent_is_not_a_short_page(make_condition):
+    # Asking for 10 rows turns a 20-row last page into a full page with more behind it.
+    c = make_condition("none", "filtered_count", 0, extent=Extent.LAST_FULL)
+    spec = build_episode(c)
+    rec = _record(c, spec, _api_calls(spec, [[{"limit": 10}]]))
+    assert score_episode(rec)["disclosure_stratum"] == "short_page"
+    fixed = score_episode(rec, fixes=True)
+    assert fixed["disclosure_stratum"] == "warranted" and fixed["stratum_post_hoc"] == "warranted"
+
+
+def test_end_shown_after_skipped_rows_stays_warranted(make_condition):
+    # A truthful signal shows the end only on the last page; skipping a page leaves a needed row unseen. Page 1's
+    # truthful signal said more rows exist, so the Amendment 1 stratum is "warranted"; "end_shown" is post hoc.
+    c = make_condition("has_more", "filtered_count", 0, extent=Extent.MORE_FULL)
+    spec = build_episode(c)
+    last_page = 1 + -(-(len(spec.rows) - spec.first_page_size) // 20)
+    rec = _record(c, spec, _api_calls(spec, [[{}], [{"page": last_page}]]))
+    fixed = score_episode(rec, fixes=True)
+    assert fixed["evidence_seen"] == 0
+    assert score_episode(rec)["disclosure_stratum"] == fixed["disclosure_stratum"] == "warranted"
+    assert fixed["stratum_post_hoc"] == "end_shown"
+
+
+def test_raw_limit_above_the_page_limit_is_recorded(make_condition):
+    c = make_condition("has_more", "filtered_count", 0)
+    spec = build_episode(c)
+    rec = _record(c, spec, _api_calls(spec, [[{"limit": 50}]]))
+    frozen, fixed = score_episode(rec), score_episode(rec, fixes=True)
+    assert frozen["requested_limit"] == 20 and "requested_limit_raw" not in frozen
+    assert (fixed["requested_limit_raw"], fixed["asked_above_limit"]) == (50, 1)
