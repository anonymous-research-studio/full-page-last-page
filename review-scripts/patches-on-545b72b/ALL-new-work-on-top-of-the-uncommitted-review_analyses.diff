+def _filled(verdicts, strata, weights):
+    return pd.DataFrame({"audit_id": range(1, len(verdicts) + 1), "episode_id": [f"e{i}" for i in range(len(verdicts))],
+                         "model": "m", "stratum": strata, "weight": weights, "verdict": verdicts})
