index 0000000..5a11d96
--- /dev/null
+++ b/scripts/audit_combined.py
@@ -0,0 +1,80 @@
+"""Combine the audit parts into one blinded worksheet: every reply in a seeded random order, with new ids.
+
+Reads each part's drawn sample (in part order) and the raw logs, builds each reply's blinded view as
+`scripts/audit_worksheet.py --blinded` does, shuffles all replies with a seeded generator, and numbers
+them 1..N. Writes, beside <out>:
+  <out>_blinded.html, <out>_blinded.csv   the combined blinded worksheet (new ids only);
+  audit_key_combined.csv                  new audit id -> part, the part's audit id, episode, model, stratum,
+                                          weight and condition;
+  audit_verdicts_combined.csv             audit_id (new), verdict, note; never overwritten.
+An existing key that would change stops the script, so verdicts already entered keep their meaning.
+Score it with `scripts/audit_error_rate.py --part audit_key_combined.csv audit_verdicts_combined.csv`
+(the key carries model, stratum and weight). Use either the combined files or the part files, not both:
+the error-rate script stops if an episode appears twice.
+
+  uv run python scripts/audit_combined.py REVIEW/final/audit_sample_part1_gpt-oss_claude.csv \
+      REVIEW/final/audit_sample_part2_mistral.csv --raw data/raw/main --out REVIEW/final/audit_worksheet_combined
+"""
+
+from __future__ import annotations
+
+import argparse
+import io
+import random
+import sys
+from pathlib import Path
+
+import pandas as pd
+
+sys.path.insert(0, str(Path(__file__).parent))
+from audit_worksheet import KEY_COLUMNS, blinded, build, extras, records_by_id, to_html_blinded
+
+
+def combine(samples: list[pd.DataFrame], by_id: dict[str, dict], seed: int) -> tuple[pd.DataFrame, pd.DataFrame]:
+    views, keys = [], []
+    for part, sample in enumerate(samples, start=1):
+        table = build(sample, by_id)
+        more = {int(a): extras(by_id[e]) for a, e in zip(sample["audit_id"], sample["episode_id"], strict=True)}
+        view = blinded(table, more).rename(columns={"audit_id": "part_audit_id"})
+        key = table[KEY_COLUMNS].rename(columns={"audit_id": "part_audit_id"}).assign(part=part)
+        views.append(view.assign(part=part))
+        keys.append(key)
+    view, key = pd.concat(views, ignore_index=True), pd.concat(keys, ignore_index=True)
+    order = list(range(len(view)))
+    random.Random(f"{seed}:combined").shuffle(order)
+    view = view.iloc[order].reset_index(drop=True)
+    view.insert(0, "audit_id", range(1, len(view) + 1))
+    key = view[["audit_id", "part", "part_audit_id"]].merge(key, on=["part", "part_audit_id"], validate="one_to_one")
+    key = key[["audit_id", "part", "part_audit_id", *[c for c in KEY_COLUMNS if c != "audit_id"]]]
+    return view.drop(columns=["part", "part_audit_id"]), key
+
+
+def main(argv: list[str] | None = None) -> None:
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("samples", nargs="+", help="each part's drawn sample CSV, in part order")
+    p.add_argument("--raw", nargs="+", required=True, help="raw episode logs (files or directories)")
+    p.add_argument("--out", required=True, help="path without extension, e.g. REVIEW/final/audit_worksheet_combined")
+    p.add_argument("--seed", type=int, default=20261025)
+    args = p.parse_args(argv)
+    view, key = combine([pd.read_csv(s) for s in args.samples], records_by_id(args.raw), args.seed)
+    out = Path(args.out)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    key_path, verdicts = out.with_name("audit_key_combined.csv"), out.with_name("audit_verdicts_combined.csv")
+    if key_path.exists() and not pd.read_csv(key_path).equals(pd.read_csv(io.StringIO(key.to_csv(index=False)))):
+        raise SystemExit(f"{key_path} exists and would change; verdicts keyed to it would lose their meaning. Nothing written.")
+    base = out.with_name(out.name + "_blinded")
+    view.to_csv(base.with_suffix(".csv"), index=False)
+    key.to_csv(key_path, index=False)
+    source = (f"{len(view)} replies from {len(args.samples)} parts, in a seeded random order with new ids. Part, original "
+              f"audit id, model, condition, stratum, weight and episode id are in {key_path.name}, not here.")
+    base.with_suffix(".html").write_text(to_html_blinded(view, "Correctness audit worksheet, combined (blinded)", source,
+                                                         verdicts.name))
+    if verdicts.exists():  # never overwrite verdicts already entered
+        print(f"kept the existing {verdicts}")
+    else:
+        pd.DataFrame({"audit_id": range(1, len(view) + 1), "verdict": "", "note": ""}).to_csv(verdicts, index=False)
+    print(f"wrote {len(view)} replies -> {base.with_suffix('.html')}, {base.with_suffix('.csv')}, {key_path} and {verdicts}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/audit_error_rate.py b/scripts/audit_error_rate.py
new file mode 100644
index 0000000..a149ad2
--- /dev/null
+++ b/scripts/audit_error_rate.py
@@ -0,0 +1,143 @@
+"""Stratum-weighted parser error rate per model, from filled-in audit worksheets (descriptive).
+
+An error is a reply where the auditor disagrees with the scorer's correctness reading (verdict
+"disagree"). Each reply carries its stratum's weight (population / sampled, from the sampler's manifest,
+in the worksheet's `weight` column), so the weighted rate estimates the share of the model's main-study
+replies whose correctness the parser misreads. Per model:
+  - the weighted error rate over the replies with "agree" or "disagree", with two 95% intervals: a
+    percentile bootstrap that resamples replies within each stratum (`bootstrap_lo`, `bootstrap_hi`),
+    which collapses to a point when every stratum's verdicts agree with each other; and a Wilson interval
+    on the Kish effective sample size (`wilson_kish_lo`, `wilson_kish_hi`, `kish_n_eff`), computed by the
+    registered H5a fallback's own function, which keeps a usable upper bound when no reply is an error
+    (added 2026-10-25, before any verdicts were filled in);
+  - bounds for the unsure verdicts: every unsure counted as agree (lower) and as disagree (upper);
+  - the unweighted rate, the counts per verdict, and the share of the population (by weight) that the
+    agree/disagree replies cover; blank verdicts are reported as not yet audited;
+  - per stratum: weight, replies, disagree, unsure, blank.
+The verdicts come from a verdicts-only file (`audit_id`, `verdict`, `note`, pre-filled with the part's
+ids), merged with its worksheet by `audit_id`; each part is given as a pair, because audit ids restart at 1
+in every part. The script stops, naming the file and the ids, if a verdicts file has an id missing from
+its worksheet, an id the worksheet lacks, or a duplicated id; and if an episode appears in two parts.
+Verdicts are read case-insensitively; anything other than agree, disagree, unsure or blank stops the
+script and names the audit ids. The worksheet's own `verdict` and `note` columns are ignored.
+
+  uv run python scripts/audit_error_rate.py \
+      --part REVIEW/final/audit_worksheet_part1.csv REVIEW/final/audit_verdicts_part1.csv \
+      [--part REVIEW/final/audit_worksheet_part2.csv REVIEW/final/audit_verdicts_part2.csv] \
+      --out REVIEW/final/audit_error_rates.csv
+or, for the combined blinded worksheet (`scripts/audit_combined.py`), whose key carries model, stratum and weight:
+  uv run python scripts/audit_error_rate.py \
+      --part REVIEW/final/audit_key_combined.csv REVIEW/final/audit_verdicts_combined.csv --out ...
+Give either the part files or the combined files, not both (an episode would appear twice, which stops the script).
+"""
+
+from __future__ import annotations
+
+import argparse
+
+import numpy as np
+import pandas as pd
+
+from fplp.analysis.hypotheses import _weighted_item_wilson
+
+VERDICTS = {"agree", "disagree", "unsure", ""}
+
+
+def _ids(values: pd.Series) -> str:
+    return ", ".join(str(i) for i in sorted(values))
+
+
+def merge_part(worksheet: str, verdicts: str) -> pd.DataFrame:
+    """One part's worksheet with its verdicts file, matched one to one by audit_id."""
+    w = pd.read_csv(worksheet).drop(columns=["verdict", "note"], errors="ignore")
+    v = pd.read_csv(verdicts, dtype={"verdict": str, "note": str})
+    if missing_cols := {"audit_id", "verdict"} - set(v.columns):
+        raise SystemExit(f"{verdicts}: missing column(s) {', '.join(sorted(missing_cols))}")
+    for name, frame in ((worksheet, w), (verdicts, v)):
+        dup = frame.loc[frame["audit_id"].duplicated(), "audit_id"]
+        if len(dup):
+            raise SystemExit(f"{name}: duplicated audit id(s) {_ids(dup.unique())}")
+    if missing := set(w["audit_id"]) - set(v["audit_id"]):
+        raise SystemExit(f"{verdicts}: audit id(s) missing, present in {worksheet}: {_ids(missing)}")
+    if extra := set(v["audit_id"]) - set(w["audit_id"]):
+        raise SystemExit(f"{verdicts}: audit id(s) not in {worksheet}: {_ids(extra)}")
+    d = w.merge(v[["audit_id", "verdict", *(["note"] if "note" in v else [])]], on="audit_id", validate="one_to_one")
+    d["verdict"] = d["verdict"].fillna("").str.strip().str.lower()
+    bad = d.loc[~d["verdict"].isin(VERDICTS), "audit_id"]
+    if len(bad):
+        raise SystemExit(f"{verdicts}: verdict must be agree, disagree, unsure or blank; check audit id(s) {_ids(bad)}")
+    return d
+
+
+def read(parts: list[tuple[str, str]]) -> pd.DataFrame:
+    d = pd.concat([merge_part(w, v) for w, v in parts], ignore_index=True)
+    if d.duplicated(["model", "episode_id"]).any():
+        raise SystemExit("an episode appears in two parts")
+    return d
+
+
+def _weighted(d: pd.DataFrame, error: pd.Series) -> float:
+    return float((d["weight"] * error).sum() / d["weight"].sum()) if len(d) else float("nan")
+
+
+def _bootstrap(d: pd.DataFrame, rng: np.random.Generator, n_boot: int) -> tuple[float, float]:
+    """Resample replies within each stratum; each stratum keeps its weight (population / sampled)."""
+    groups = [(g["weight"].iloc[0] * len(g), (g["verdict"] == "disagree").to_numpy(float)) for _, g in d.groupby("stratum")]
+    total = sum(w for w, _ in groups)
+    if not total:
+        return float("nan"), float("nan")
+    stats = np.zeros(n_boot)
+    for w, e in groups:
+        stats += w / total * rng.choice(e, size=(n_boot, len(e)), replace=True).mean(axis=1)
+    return float(np.quantile(stats, 0.025)), float(np.quantile(stats, 0.975))
+
+
+def rates(d: pd.DataFrame, seed: int = 0, n_boot: int = 2000) -> tuple[pd.DataFrame, pd.DataFrame]:
+    rng = np.random.default_rng(seed)
+    per_model, per_stratum = [], []
+    for model, g in d.groupby("model"):
+        judged = g[g["verdict"].isin(["agree", "disagree"])]
+        decided = g[g["verdict"].isin(["agree", "disagree", "unsure"])]
+        lo, hi = _bootstrap(judged, rng, n_boot)
+        errors = (judged["verdict"] == "disagree").astype(float)
+        wilson = _weighted_item_wilson(errors, judged["episode_id"], judged["weight"]) if len(judged) else {}
+        n_eff = float(judged["weight"].sum() ** 2 / (judged["weight"] ** 2).sum()) if len(judged) else float("nan")
+        per_model.append({
+            "model": model, "replies": len(g), "agree": int((g["verdict"] == "agree").sum()),
+            "disagree": int((g["verdict"] == "disagree").sum()), "unsure": int((g["verdict"] == "unsure").sum()),
+            "not_yet_audited": int((g["verdict"] == "").sum()),
+            "weighted_error_rate": _weighted(judged, judged["verdict"] == "disagree"),
+            "bootstrap_lo": lo, "bootstrap_hi": hi, "wilson_kish_lo": wilson.get("lo", float("nan")),
+            "wilson_kish_hi": wilson.get("hi", float("nan")), "kish_n_eff": n_eff,
+            "lower_bound_unsure_as_agree": _weighted(decided, decided["verdict"] == "disagree"),
+            "upper_bound_unsure_as_disagree": _weighted(decided, decided["verdict"].isin(["disagree", "unsure"])),
+            "unweighted_error_rate": float((judged["verdict"] == "disagree").mean()) if len(judged) else float("nan"),
+            "population_share_covered": float(judged["weight"].sum() / g["weight"].sum()) if len(g) else float("nan"),
+        })
+        for stratum, s in g.groupby("stratum"):
+            per_stratum.append({"model": model, "stratum": stratum, "weight": s["weight"].iloc[0], "replies": len(s),
+                                "disagree": int((s["verdict"] == "disagree").sum()),
+                                "unsure": int((s["verdict"] == "unsure").sum()), "blank": int((s["verdict"] == "").sum())})
+    return pd.DataFrame(per_model), pd.DataFrame(per_stratum)
+
+
+def main(argv: list[str] | None = None) -> None:
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("--part", nargs=2, action="append", required=True, metavar=("WORKSHEET", "VERDICTS"),
+                   help="a part's worksheet CSV and its verdicts CSV; repeat for each part")
+    p.add_argument("--out", help="CSV of the per-model rates; the per-stratum counts go beside it (_strata.csv)")
+    p.add_argument("--seed", type=int, default=0)
+    p.add_argument("--n-boot", type=int, default=2000)
+    args = p.parse_args(argv)
+    per_model, per_stratum = rates(read([tuple(part) for part in args.part]), args.seed, args.n_boot)
+    with pd.option_context("display.width", 220, "display.max_columns", 30):
+        print(per_model.round(4).to_string(index=False))
+        print()
+        print(per_stratum.to_string(index=False))
+    if args.out:
+        per_model.to_csv(args.out, index=False)
+        per_stratum.to_csv(args.out.replace(".csv", "_strata.csv"), index=False)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/audit_sample.py b/scripts/audit_sample.py
new file mode 100644
index 0000000..887995b
--- /dev/null
+++ b/scripts/audit_sample.py
@@ -0,0 +1,143 @@
+"""Draw the stratified sample for the lead author's audit of correctness scoring (PENDING.md, section 3).
+
+Rescoring and reproduction checked the pipeline, not whether the answer parsers classify replies
+correctly. This draws main-study replies per model (40 by default, so 120 across the three confirmatory
+models), with places reserved for the reply shapes most likely to fool a parser and the cells where
+correctness matters most. Each episode joins the first stratum it fits:
+  malformed        no "FINAL ANSWER:" line
+  several_numbers  a count or amount answer whose final line holds two or more numbers (record ids,
+                   dates, page numbers and "of N" totals aside, as the parser drops them)
+  bound            a bound or approximation in the final line ("at least 5", "about 12", "6+")
+  partial_export   an export answer whose ids are some but not all of the gold ids, or extra ones
+  yes_no_reversal  an exists answer whose final line holds both "yes" and "no"
+  false_signal     a false-signal cell (false end signals and visible conflicts; the harm claims)
+  exists           an exists task (yes/no; luck and reversals)
+  other            everything else
+Quotas per model: up to 4 from each of the first five strata, 10 false-signal, 6 exists, the rest
+other; a stratum with too few episodes gives its places to other. Empty replies (protocol failures,
+excluded from every analysis) are left out. The CSV lists each reply in a random order with the
+scorer's reading beside it and blank audit columns; the manifest records the seed, the population and
+sample per stratum, and each stratum's weight (population / sampled) for estimates.
+
+  uv run python scripts/audit_sample.py data/raw/main --config configs/runs/main.yaml \
+      --cutoff 2026-10-25T17:00:00-04:00 --out data/processed/audit_sample.csv
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import random
+import re
+from datetime import UTC, datetime
+from pathlib import Path
+
+import pandas as pd
+
+from fplp.metrics import (
+    _NOT_ANSWER,
+    _episode_files,
+    _plan,
+    _read_records,
+    final_answer,
+    normalize,
+    score_episode,
+    select_records,
+)
+
+STRATA = ["malformed", "several_numbers", "bound", "partial_export", "yes_no_reversal", "false_signal", "exists", "other"]
+QUOTAS = {"malformed": 4, "several_numbers": 4, "bound": 4, "partial_export": 4, "yes_no_reversal": 4,
+          "false_signal": 10, "exists": 6}
+_BOUND = re.compile(r"\b(?:at least|at most|more than|fewer than|less than|up to|or more|or fewer|approximately|"
+                    r"about|around|roughly|over|under)\b|~\s*\d|\d\s*\+", re.IGNORECASE)
+_IDS = re.compile(r"\b(?:TCK|SKU|ORD)-\d+\b")
+
+
+def stratum(rec: dict) -> str:
+    text, gold, c = rec["final_text"], rec["gold"], rec["condition"]
+    answer = final_answer(text)
+    kind = gold["answer_type"]
+    if not re.search(r"FINAL ANSWER:", normalize(text), re.IGNORECASE):
+        return "malformed"
+    if kind in ("count", "amount") and len(re.findall(r"\d[\d,]*(?:\.\d+)?", _NOT_ANSWER.sub(" ", answer.replace("$", "")))) >= 2:
+        return "several_numbers"
+    if kind in ("count", "amount") and _BOUND.search(answer):
+        return "bound"
+    if kind == "id_set":
+        ids = set(_IDS.findall(answer.upper())) or set(_IDS.findall(normalize(text).upper()))
+        if ids and ids != set(gold["value"]):
+            return "partial_export"
+    if kind == "yes_no" and {w.lower() for w in re.findall(r"\b(yes|no)\b", answer, re.IGNORECASE)} == {"yes", "no"}:
+        return "yes_no_reversal"
+    if c.get("arm") == "conflict":
+        return "false_signal"
+    if c.get("task_type") == "exists":
+        return "exists"
+    return "other"
+
+
+def draw(records: list[dict], models: list[str], per_model: int, seed: int) -> tuple[pd.DataFrame, dict]:
+    rows, manifest = [], {}
+    for model in models:
+        pool: dict[str, list[dict]] = {s: [] for s in STRATA}
+        for rec in records:
+            if rec["model"] == model and rec["final_text"].strip():
+                pool[stratum(rec)].append(rec)
+        picked, spare = {}, per_model
+        for s in STRATA[:-1]:
+            k = min(QUOTAS[s], len(pool[s]))
+            picked[s] = random.Random(f"{seed}:{model}:{s}").sample(pool[s], k)
+            spare -= k
+        k = min(max(spare, 0), len(pool["other"]))
+        picked["other"] = random.Random(f"{seed}:{model}:other").sample(pool["other"], k)
+        manifest[model] = {s: {"population": len(pool[s]), "sampled": len(picked[s]),
+                               "weight": round(len(pool[s]) / len(picked[s]), 4) if picked[s] else None} for s in STRATA}
+        for s, recs in picked.items():
+            for rec in recs:
+                scored, gold, c = score_episode(rec), rec["gold"], rec["condition"]
+                rows.append({
+                    "episode_id": rec["episode_id"], "model": model, "stratum": s, "weight": manifest[model][s]["weight"],
+                    "arm": c.get("arm"), "signal_form": c.get("signal_form"), "conflict": c.get("conflict"),
+                    "extent": c.get("extent"), "task_type": c.get("task_type"), "answer_format": c.get("answer_format"),
+                    "question": rec["question"], "gold": json.dumps(gold.get("value", gold.get("accepted"))),
+                    "scorer_final_answer": final_answer(rec["final_text"]), "scorer_correct": scored["correct"],
+                    "final_text": rec["final_text"], "audit_correct": "", "audit_note": "",
+                })
+    table = pd.DataFrame(rows).sample(frac=1, random_state=seed).reset_index(drop=True)
+    table.insert(0, "audit_id", range(1, len(table) + 1))
+    return table, manifest
+
+
+def main(argv: list[str] | None = None) -> None:
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("inputs", nargs="+")
+    p.add_argument("--config", required=True, help="the run config whose planned episodes to sample (main.yaml)")
+    p.add_argument("--models-file", default="configs/models.yaml")
+    p.add_argument("--cutoff", type=datetime.fromisoformat, help="as fplp score --cutoff")
+    p.add_argument("--models", help="comma-separated; default: the config's models")
+    p.add_argument("--per-model", type=int, default=40)
+    p.add_argument("--seed", type=int, default=20261025)
+    p.add_argument("--out", required=True, help="CSV for the audit; the manifest goes beside it")
+    args = p.parse_args(argv)
+    files = _episode_files(args.inputs)
+    records, _ = _read_records(files)
+    plan = _plan(args.config, args.models_file)
+    records, report = select_records(records, plan, cutoff=args.cutoff)
+    for line in report:
+        print(line)
+    models = args.models.split(",") if args.models else sorted(plan)
+    table, strata = draw(records, models, args.per_model, args.seed)
+    out = Path(args.out)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    table.to_csv(out, index=False)
+    manifest = {"created": datetime.now(UTC).isoformat(), "seed": args.seed, "per_model": args.per_model,
+                "quotas": QUOTAS, "cutoff": args.cutoff.isoformat() if args.cutoff else None, "config": args.config,
+                "inputs": {str(f): hashlib.sha256(f.read_bytes()).hexdigest() for f in files}, "strata": strata}
+    out.with_suffix(".manifest.json").write_text(json.dumps(manifest, indent=2))
+    print(f"wrote {len(table)} replies -> {out} (manifest: {out.with_suffix('.manifest.json')})")
+    print(pd.DataFrame({m: {s: f"{v['sampled']}/{v['population']}" for s, v in st.items()} for m, st in strata.items()}).to_string())
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/audit_worksheet.py b/scripts/audit_worksheet.py
new file mode 100644
index 0000000..0212447
--- /dev/null
+++ b/scripts/audit_worksheet.py
@@ -0,0 +1,308 @@
+"""Build the worksheet for a drawn audit sample: a reading view (HTML), the same fields as CSV, and a
+verdicts-only file to fill in.
+
+For each sampled reply: its audit id, episode id, model, stratum and condition; the question and gold
+answer; the model's full final text; the scorer's reading (the final answer it parsed, `correct`, the
+COMPLETENESS line where the answer format asks for one, the disclosure flag); a summary of the calls
+(each call's turn, arguments and outcome, and the rows seen). Verdicts go only in the verdicts file
+(`audit_id`, `verdict`, `note`, pre-filled with the part's ids). The verdict is the auditor's judgment of
+the scorer's correctness reading (`scorer_correct`): "agree", "disagree" or "unsure".
+`scripts/audit_error_rate.py` merges the verdicts with the worksheet by audit id and computes a
+stratum-weighted parser error rate per model.
+
+  uv run python scripts/audit_worksheet.py REVIEW/final/audit_sample_part1_gpt-oss_claude.csv data/raw/main \
+      --out REVIEW/final/audit_worksheet_part1
+writes <out>.html, <out>.csv and the verdicts file (audit_verdicts_part1.csv: "worksheet" in the name becomes
+"verdicts"; otherwise <out>_verdicts.csv), never overwriting an existing verdicts file.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import html
+import json
+import re
+from pathlib import Path
+
+import pandas as pd
+
+from fplp.metrics import _episode_files, _read_records, final_answer, normalize, score_episode
+
+CONDITION = ["arm", "signal_form", "conflict", "extent", "task_type", "task_need", "answer_format", "documented"]
+COLUMNS = ["audit_id", "episode_id", "model", "stratum", "weight", *CONDITION, "question", "gold",
+           "scorer_final_answer", "scorer_correct", "stated_completeness", "disclosure_flag", "evidence_seen",
+           "calls_summary", "final_text"]
+
+
+def _arg_text(args: dict) -> str:
+    shown = {k: (str(v)[:14] + "…" if len(str(v)) > 15 else v) for k, v in args.items() if v not in (None, "")}
+    return ", ".join(f"{k}={v}" for k, v in shown.items())
+
+
+def calls_summary(rec: dict) -> str:
+    """One line per call (turn, tool, arguments, outcome), then the rows of the target set seen."""
+    lines, seen = [], set()
+    for x in rec["calls"]:
+        turn = f"t{x['turn']}" if x.get("turn") is not None else "t?"
+        if x["error"]:
+            outcome = f"error: {x['error']}"
+        elif not x["is_target"]:
+            outcome = "not the target query: 0 answer rows"
+        elif x["n_rows"]:
+            outcome = f"rows {x['offset'] + 1}-{x['offset'] + x['n_rows']}"
+            seen.update(range(x["offset"], x["offset"] + x["n_rows"]))
+        else:
+            outcome = "0 rows"
+        lines.append(f"{turn} {x['tool']}({_arg_text(x['arguments'])}) -> {outcome}")
+    lines.append(f"rows seen: {len(seen)} of {rec['n_items']}")
+    return "\n".join(lines)
+
+
+_ID_PATTERN = {"id_set": r"TCK-\d+", "sku_any": r"SKU-\d+"}
+
+
+def scorer_ids(rec: dict) -> tuple[list[str], str] | None:
+    """The ids the scorer reads for an id answer, as `fplp.metrics.is_correct` reads them: from the final
+    line, or from the whole reply when the final line holds none. None for other answer types."""
+    pattern = _ID_PATTERN.get(rec["gold"]["answer_type"])
+    if pattern is None:
+        return None
+    final = set(re.findall(pattern, final_answer(rec["final_text"]).upper()))
+    if final:
+        return sorted(final), "from the final line"
+    return sorted(set(re.findall(pattern, normalize(rec["final_text"]).upper()))), "from the body; the final line has none"
+
+
+def served_rows(rec: dict, skus: list[str]) -> dict[str, str]:
+    """Each named SKU's row as the server returned it (first time served), with the call that served it."""
+    found: dict[str, str] = {}
+
+    def walk(o, where: str) -> None:
+        if isinstance(o, dict):
+            if o.get("sku") in skus and o["sku"] not in found:
+                found[o["sku"]] = f"{json.dumps(o)} ({where})"
+            for v in o.values():
+                walk(v, where)
+        elif isinstance(o, list):
+            for v in o:
+                walk(v, where)
+
+    for x in rec["calls"]:
+        if x["is_target"] and not x["error"]:
+            try:
+                walk(json.loads(x["output"]), f"served at t{x.get('turn', '?')}, rows {x['offset'] + 1}-{x['offset'] + x['n_rows']}")
+            except (json.JSONDecodeError, TypeError):
+                continue
+    return {s: found.get(s, "not in any served row") for s in skus}
+
+
+def gold_text(rec: dict) -> str:
+    """The gold as every worksheet shows it: the value, or for a name-one task, which has no single value,
+    the rule `fplp.metrics.is_correct` applies, with the accepted SKUs."""
+    gold = rec["gold"]
+    if gold["answer_type"] == "sku_any":
+        return (f"rule: any in-stock SKU among the {rec['n_items']} matching rows; correct if every SKU the answer "
+                f"names is one of the {len(gold['accepted'])} accepted: {', '.join(gold['accepted'])}")
+    return json.dumps(gold.get("value", gold.get("accepted")))
+
+
+def extras(rec: dict) -> list[tuple[str, str]]:
+    """Rows the auditor needs beyond the parsed fields: the served row of each SKU a name-one answer names,
+    and, for an export whose final line has no ids, the ids the scorer took from the body."""
+    taken = scorer_ids(rec)
+    if taken is None:
+        return []
+    ids, source = taken
+    gold, out = rec["gold"], []
+    if gold["answer_type"] == "sku_any":
+        out.append((f"SKU(s) the scorer took ({source})", ", ".join(ids) or "none"))
+        for sku, row in served_rows(rec, ids).items():
+            out.append((f"served row for {sku}", row))
+    elif source.startswith("from the body"):
+        want = set(gold["value"])
+        out.append((f"IDs the scorer took ({source})", f"{len(ids)}: {', '.join(ids) or 'none'}"))
+        missing, extra = ", ".join(sorted(want - set(ids))) or "none", ", ".join(sorted(set(ids) - want)) or "none"
+        out.append(("against the gold IDs",
+                    f"{len(set(ids) & want)} of {len(want)} gold IDs present; missing: {missing}; extra: {extra}"))
+    return out
+
+
+def records_by_id(raw: list[str]) -> dict[str, dict]:
+    records, _ = _read_records(_episode_files(raw))
+    by_id: dict[str, dict] = {}
+    for r in records:
+        by_id.setdefault(r["episode_id"], r)
+    return by_id
+
+
+def build(sample: pd.DataFrame, raw: list[str] | dict[str, dict]) -> pd.DataFrame:
+    by_id = raw if isinstance(raw, dict) else records_by_id(raw)
+    if missing := sorted(set(sample["episode_id"]) - set(by_id)):
+        raise SystemExit(f"{len(missing)} sampled episode(s) not in the raw logs, e.g. {missing[:3]}")
+    rows = []
+    for _, s in sample.iterrows():
+        rec = by_id[s["episode_id"]]
+        scored, c = score_episode(rec), rec["condition"]
+        completeness = c.get("answer_format", "final_line") == "completeness"
+        rows.append({
+            "audit_id": s["audit_id"], "episode_id": s["episode_id"], "model": s["model"], "stratum": s["stratum"],
+            "weight": s["weight"], **{k: c.get(k, scored.get(k)) for k in CONDITION},
+            "question": rec["question"], "gold": gold_text(rec),
+            "scorer_final_answer": s["scorer_final_answer"], "scorer_correct": scored["correct"],
+            "stated_completeness": scored["stated_completeness"] if completeness else "",
+            "disclosure_flag": scored["disclosure_flag"], "evidence_seen": scored["evidence_seen"],
+            "calls_summary": calls_summary(rec), "final_text": rec["final_text"],
+        })
+    return pd.DataFrame(rows, columns=COLUMNS).sort_values("audit_id")
+
+
+STYLE = """
+:root { --bg: #ffffff; --fg: #1d1d1f; --muted: #5f6368; --line: #d9d9de; --card: #f7f7f9; --accent: #0b57d0; }
+@media (prefers-color-scheme: dark) { :root { --bg: #161618; --fg: #ececf0; --muted: #a0a0a8; --line: #3a3a40;
+  --card: #1f1f23; --accent: #8ab4f8; } }
+body { background: var(--bg); color: var(--fg); font: 15px/1.5 -apple-system, "Segoe UI", sans-serif;
+  max-width: 980px; margin: 0 auto; padding: 24px 16px 64px; }
+h1 { font-size: 22px; margin: 0 0 4px; } .muted { color: var(--muted); }
+section { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; margin: 18px 0; }
+section h2 { font-size: 16px; margin: 0 0 8px; } table { border-collapse: collapse; width: 100%; }
+td { padding: 3px 8px 3px 0; vertical-align: top; } td.k { color: var(--muted); width: 190px; white-space: nowrap; }
+pre { white-space: pre-wrap; word-break: break-word; background: var(--bg); border: 1px solid var(--line);
+  border-radius: 6px; padding: 10px; margin: 6px 0; font: 13px/1.45 ui-monospace, Menlo, monospace; }
+.verdict { margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--line); }
+.box { display: inline-block; margin-right: 18px; } nav a { color: var(--accent); margin-right: 8px; }
+"""
+
+
+def verdicts_path(out: Path) -> Path:
+    name = out.name.replace("worksheet", "verdicts") if "worksheet" in out.name else f"{out.name}_verdicts"
+    return out.with_name(name + ".csv")
+
+
+def to_html(table: pd.DataFrame, title: str, source: str, verdicts_name: str = "the verdicts file",
+            more: dict[int, list[tuple[str, str]]] | None = None) -> str:
+    e = lambda v: html.escape("" if pd.isna(v) else str(v))  # noqa: E731
+    counts = table.groupby(["model", "stratum"]).size().unstack(fill_value=0)
+    parts = [(f"<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' "
+              f"content='width=device-width, initial-scale=1'><title>{e(title)}</title><style>{STYLE}</style></head><body>"),
+             f"<h1>{e(title)}</h1><p class='muted'>{e(source)}</p>",
+             (f"<p>Record each verdict in <code>{e(verdicts_name)}</code> beside this file (audit_id, verdict, note): "
+              "<b>agree</b> if the scorer's correctness reading "
+              "(<code>correct</code>) is right for the reply, <b>disagree</b> if it is wrong, <b>unsure</b> otherwise; "
+              "add a note for every disagree or unsure. The other parsed fields are shown for context.</p>"),
+             counts.to_html(border=0), "<nav>" + "".join(f"<a href='#a{int(i)}'>{int(i)}</a>" for i in table["audit_id"]) + "</nav>"]
+    for _, r in table.iterrows():
+        condition = ", ".join(f"{k}={e(r[k])}" for k in CONDITION if not pd.isna(r[k]) and str(r[k]) != "")
+        parsed = f"correct={e(r['scorer_correct'])}; disclosure_flag={e(r['disclosure_flag'])}"
+        if str(r["stated_completeness"]) not in ("", "nan"):
+            parsed += f"; stated_completeness={e(r['stated_completeness'])}"
+        added = dict((more or {}).get(int(r["audit_id"]), []))
+        gold_cell = e(r["gold"]) if str(r["gold"]).startswith("rule: ") else f"<code>{e(r['gold'])}</code>"
+        extra_rows = "".join(f"<tr><td class='k'>{e(k)}</td><td><code>{e(v)}</code></td></tr>" for k, v in added.items())
+        parts.append(
+            f"<section id='a{int(r['audit_id'])}'><h2>Audit {int(r['audit_id'])} · {e(r['model'])} · {e(r['stratum'])}</h2><table>"
+            f"<tr><td class='k'>episode</td><td><code>{e(r['episode_id'])}</code> (weight {e(r['weight'])})</td></tr>"
+            f"<tr><td class='k'>condition</td><td>{condition}</td></tr>"
+            f"<tr><td class='k'>question</td><td>{e(r['question'])}</td></tr>"
+            f"<tr><td class='k'>gold answer</td><td>{gold_cell}</td></tr>"
+            f"<tr><td class='k'>scorer read</td><td><code>{e(r['scorer_final_answer'])}</code></td></tr>"
+            f"<tr><td class='k'>parsed fields</td><td>{parsed}; rows the answer needed seen: {e(r['evidence_seen'])}</td></tr>"
+            f"{extra_rows}</table><div class='muted'>calls</div><pre>{e(r['calls_summary'])}</pre>"
+            f"<div class='muted'>final text</div><pre>{e(r['final_text'])}</pre>"
+            "<div class='verdict'><span class='box'>☐ agree</span><span class='box'>☐ disagree</span>"
+            "<span class='box'>☐ unsure</span> note: ____________________</div></section>")
+    parts.append("</body></html>")
+    return "\n".join(parts)
+
+
+KEY_COLUMNS = ["audit_id", "episode_id", "model", "stratum", "weight", *CONDITION]
+BLIND_NOTE = ("Blinding is partial: the wording of a reply, a COMPLETENESS line, or a reply's mention of a 'more' flag, "
+              "a cursor or a page can still point to the model or the condition.")
+
+
+def blinded(table: pd.DataFrame, more: dict[int, list[tuple[str, str]]]) -> pd.DataFrame:
+    """The worksheet without model, condition, stratum, weight, episode id, calls or retrieval fields; the
+    scorer's reading, and the served rows or ids it took, stay."""
+    rows = []
+    for _, r in table.iterrows():
+        added = dict(more.get(int(r["audit_id"]), []))
+        rows.append({"audit_id": r["audit_id"], "question": r["question"], "gold": r["gold"],
+                     "scorer_final_answer": r["scorer_final_answer"], "scorer_correct": r["scorer_correct"],
+                     "disclosure_flag": r["disclosure_flag"],
+                     "scorer_detail": " | ".join(f"{k}: {v}" for k, v in added.items()), "final_text": r["final_text"]})
+    return pd.DataFrame(rows)
+
+
+def to_html_blinded(view: pd.DataFrame, title: str, source: str, verdicts_name: str) -> str:
+    e = lambda v: html.escape("" if pd.isna(v) else str(v))  # noqa: E731
+    parts = [(f"<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' "
+              f"content='width=device-width, initial-scale=1'><title>{e(title)}</title><style>{STYLE}</style></head><body>"),
+             f"<h1>{e(title)}</h1><p class='muted'>{e(source)} {e(BLIND_NOTE)}</p>",
+             (f"<p>Record each verdict in <code>{e(verdicts_name)}</code> (audit_id, verdict, note): <b>agree</b> if the "
+              "scorer's correctness reading (<code>correct</code>) is right for the reply, <b>disagree</b> if it is wrong, "
+              "<b>unsure</b> otherwise; add a note for every disagree or unsure.</p>"),
+             "<nav>" + "".join(f"<a href='#a{int(i)}'>{int(i)}</a>" for i in view["audit_id"]) + "</nav>"]
+    for _, r in view.iterrows():
+        detail = "".join(f"<tr><td class='k'>{e(k)}</td><td><code>{e(v)}</code></td></tr>"
+                         for k, v in (item.split(": ", 1) for item in str(r["scorer_detail"]).split(" | ") if ": " in item))
+        gold_cell = e(r["gold"]) if str(r["gold"]).startswith("rule: ") else f"<code>{e(r['gold'])}</code>"
+        parts.append(
+            f"<section id='a{int(r['audit_id'])}'><h2>Audit {int(r['audit_id'])}</h2><table>"
+            f"<tr><td class='k'>question</td><td>{e(r['question'])}</td></tr>"
+            f"<tr><td class='k'>gold answer</td><td>{gold_cell}</td></tr>"
+            f"<tr><td class='k'>scorer read</td><td><code>{e(r['scorer_final_answer'])}</code></td></tr>"
+            f"<tr><td class='k'>parsed fields</td><td>correct={e(r['scorer_correct'])}; disclosure_flag={e(r['disclosure_flag'])}</td></tr>"
+            f"{detail}</table><div class='muted'>final text</div><pre>{e(r['final_text'])}</pre>"
+            "<div class='verdict'><span class='box'>☐ agree</span><span class='box'>☐ disagree</span>"
+            "<span class='box'>☐ unsure</span> note: ____________________</div></section>")
+    parts.append("</body></html>")
+    return "\n".join(parts)
+
+
+def main(argv: list[str] | None = None) -> None:
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("sample_csv")
+    p.add_argument("raw", nargs="+", help="raw episode logs (files or directories)")
+    p.add_argument("--out", required=True, help="path without extension; writes .html, .csv and the verdicts file")
+    p.add_argument("--html-only", action="store_true", help="rewrite only the HTML; leave the CSV and the verdicts file as they are")
+    p.add_argument("--blinded", action="store_true",
+                   help="write only <out>_blinded.html, <out>_blinded.csv and the key file (model, condition, stratum, weight "
+                   "per audit id: \"worksheet\" in the name becomes \"key\"); the worksheet and verdicts files are not touched")
+    args = p.parse_args(argv)
+    sample_path = Path(args.sample_csv)
+    by_id = records_by_id(args.raw)
+    sample = pd.read_csv(sample_path)
+    table = build(sample, by_id)
+    more = {int(a): extras(by_id[eid]) for a, eid in zip(sample["audit_id"], sample["episode_id"], strict=True)}
+    out = Path(args.out)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    verdicts = verdicts_path(out)
+    if args.blinded:
+        view = blinded(table, more)
+        base = out.with_name(out.name + "_blinded")
+        key = out.with_name((out.name.replace("worksheet", "key") if "worksheet" in out.name else out.name + "_key") + ".csv")
+        view.to_csv(base.with_suffix(".csv"), index=False)
+        base.with_suffix(".html").write_text(to_html_blinded(
+            view, "Correctness audit worksheet (blinded)",
+            f"{len(view)} replies. Model, condition, stratum, weight and episode id are in {key.name}, not here.", verdicts.name))
+        table[KEY_COLUMNS].to_csv(key, index=False)
+        print(f"wrote {base.with_suffix('.html')}, {base.with_suffix('.csv')} and {key}")
+        return
+    digest = hashlib.sha256(sample_path.read_bytes()).hexdigest()
+    title = f"Correctness audit worksheet: {', '.join(sorted(table['model'].unique()))}"
+    out.with_suffix(".html").write_text(to_html(table, title, f"{len(table)} replies from {sample_path.name} "
+                                                              f"(sha256 {digest[:16]}…), drawn with the sampler's manifest beside it",
+                                                verdicts.name, more))
+    if args.html_only:
+        print(f"wrote {out.with_suffix('.html')} only")
+        return
+    table.to_csv(out.with_suffix(".csv"), index=False)
+    if verdicts.exists():  # never overwrite verdicts already entered
+        print(f"kept the existing {verdicts}")
+    else:
+        pd.DataFrame({"audit_id": sorted(table["audit_id"]), "verdict": "", "note": ""}).to_csv(verdicts, index=False)
+    print(f"wrote {len(table)} replies -> {out.with_suffix('.html')}, {out.with_suffix('.csv')} and {verdicts}")
+
+
+if __name__ == "__main__":
+    main()
