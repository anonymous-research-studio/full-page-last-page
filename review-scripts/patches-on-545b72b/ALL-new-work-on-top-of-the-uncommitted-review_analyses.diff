+    verdicts.write_text("audit_id,verdict,note\n1,agree,\n2,disagree,x\n3,,\n4,agree,\n5,agree,\n")
+    d = audit_error_rate.read([(str(tmp_path / "audit_key_combined.csv"), str(verdicts))])
+    assert set(d["model"]) == {"a", "b"} and (d["weight"] == 2.0).all()
