+"""The sampler for the correctness audit (scripts/audit_sample.py)."""
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+from fplp.agents.scripted import ScriptedClient
+from fplp.episode import run_episode
+from fplp.tasks.specs import build_episode
+
+_spec = importlib.util.spec_from_file_location("audit_sample", Path(__file__).parents[1] / "scripts" / "audit_sample.py")
+audit_sample = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(audit_sample)
+
+
+def _rec(text, answer_type="count", value=3, arm="core", task_type="filtered_count"):
+    return {"final_text": text, "gold": {"answer_type": answer_type, "value": value},
+            "condition": {"arm": arm, "task_type": task_type}}
+
+
+@pytest.mark.parametrize(("rec", "expected"), [
+    (_rec("There are 3 matching orders."), "malformed"),
+    (_rec("FINAL ANSWER: 3 (or 5 if the refunds count)"), "several_numbers"),
+    (_rec("FINAL ANSWER: 3 of the 40 orders"), "other"),  # "of 40" is a total the parser drops
+    (_rec("FINAL ANSWER: at least 3"), "bound"),
+    (_rec("FINAL ANSWER: 6+"), "bound"),
+    (_rec("FINAL ANSWER: TCK-1, TCK-2", "id_set", ["TCK-1", "TCK-2", "TCK-3"], task_type="export_all"), "partial_export"),
+    (_rec("FINAL ANSWER: TCK-1, TCK-2", "id_set", ["TCK-1", "TCK-2"], task_type="export_all"), "other"),
+    (_rec("FINAL ANSWER: No - yes, one exists", "yes_no", "yes", task_type="exists"), "yes_no_reversal"),
+    (_rec("FINAL ANSWER: 3", arm="conflict"), "false_signal"),
+    (_rec("FINAL ANSWER: yes", "yes_no", "yes", task_type="exists"), "exists"),
+    (_rec("FINAL ANSWER: 3"), "other"),
+])
+def test_strata(rec, expected):
+    assert audit_sample.stratum(rec) == expected
+
+
+def _episodes(make_condition, n):
+    out = []
+    for i in range(n):
+        c = make_condition("has_more", ["filtered_count", "exists"][i % 2], i)
+        rec = run_episode(ScriptedClient("f", "follow_all"), build_episode(c), max_tool_calls=12)
+        rec.update(episode_id=f"e{i}", model="m")
+        out.append(rec)
+    return out
+
+
+def test_quotas_spare_places_and_weights(make_condition):
+    recs = _episodes(make_condition, 30)
+    recs[0]["final_text"] = "no final line here"
+    recs[1]["final_text"] = ""  # an empty reply is never sampled
+    table, manifest = audit_sample.draw(recs, ["m"], per_model=12, seed=1)
+    m = manifest["m"]
+    assert m["malformed"] == {"population": 1, "sampled": 1, "weight": 1.0}
+    assert m["exists"]["sampled"] == 6 and m["exists"]["population"] == 14
+    assert len(table) == 12 and table["episode_id"].is_unique and "e1" not in set(table["episode_id"])
+    assert m["other"]["sampled"] == 12 - 1 - 6  # the empty strata's places go to other
+    assert list(table["audit_id"]) == list(range(1, 13))
+
+
+def test_same_seed_same_sample(make_condition):
+    recs = _episodes(make_condition, 20)
+    a, _ = audit_sample.draw(recs, ["m"], per_model=10, seed=7)
+    b, _ = audit_sample.draw(recs, ["m"], per_model=10, seed=7)
+    c, _ = audit_sample.draw(recs, ["m"], per_model=10, seed=8)
+    assert a.equals(b) and not a.equals(c)
