+"""The cost of not stopping and the form-against-form contrasts (scripts/cost_of_not_stopping.py, form_contrasts.py)."""
+
+import importlib.util
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from fplp.analysis.hypotheses import MAIN_EXPLICIT
+
+
+def _load(name):
+    spec = importlib.util.spec_from_file_location(name, Path(__file__).parents[1] / "scripts" / f"{name}.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+cost_of_not_stopping, form_contrasts = _load("cost_of_not_stopping"), _load("form_contrasts")
+
+
+def _scored(value_of, items=6, extents=("more_full", "last_full", "more_short")):
+    """Core-arm, final-line, needs-all episodes: one per item, form and extent; value_of(form, extent, item)
+    gives (n_calls, follow_up)."""
+    rows = []
+    for extent in extents:
+        for form in ["none", *MAIN_EXPLICIT]:
+            for item in range(items):
+                calls, follow = value_of(form, extent, item)
+                rows.append({"model": "m", "arm": "core", "signal_form": form, "extent": extent, "task_need": "needs_all",
+                             "task_type": "filtered_count", "item": item, "answer_format": "final_line", "conflict": None,
+                             "settled_on_page1": 0, "own_small_page": 0, "stop_reason": "end_turn", "empty_reply": 0,
+                             "documented": True, "follow_up": follow, "followup_calls": calls - 1, "n_calls": calls,
+                             "tokens_in": 1000 * calls, "hit_cap": 0, "evidence_seen": 1})
+    return pd.DataFrame(rows)
+
+
+def test_cost_adds_where_more_rows_exist_and_saves_on_a_last_page():
+    def value(form, extent, item):
+        if extent == "last_full":
+            return (2 if form == "none" else 1), 0  # no signal costs one extra call on a real last page
+        return (2 if form == "none" else 3), 1      # a signal draws one more call where more rows exist
+    means, c = cost_of_not_stopping.cost(_scored(value), n_boot=200)
+    get = lambda cell, contrast, m: c[(c.cell == cell) & (c.contrast == contrast) & (c.measure == m)].iloc[0]  # noqa: E731
+    assert get("more rows exist, full page 1", "has_more - none", "n_calls")["diff"] == pytest.approx(1)
+    assert get("more rows exist, full page 1", "any signal - none", "tokens_in")["diff"] == pytest.approx(1000)
+    assert get("real full last page", "none - total_count", "n_calls")["diff"] == pytest.approx(1)
+    assert set(c["label"]) == {cost_of_not_stopping.LABEL}
+    assert len(means) == 3 * (1 + len(MAIN_EXPLICIT)) and (means["episodes"] == 6).all()
+
+
+def test_form_contrasts_cover_every_pair_and_are_post_hoc_by_default():
+    t = form_contrasts.contrasts(_scored(lambda f, e, i: (1, int(f == "total_count"))), n_boot=200)
+    assert len(t) == 10 and set(t["label"]) == {"post hoc"}
+    row = t[t.contrast == "has_more - total_count, fetch past a full last page"].iloc[0]
+    assert row["diff"] == pytest.approx(-1) and row["n"] == 6
+
+
+def test_form_contrast_labels_follow_the_hypotheses_families():
+    hyp = pd.DataFrame({"family": ["registered", "amended", "registered"],
+                        "test": ["none - has_more, fetch past a full last page",          # form against none: no match
+                                 "nl_note_json - total_count, fetch when page 1 suffices",  # another cell: no match
+                                 "next_cursor - has_more, fetch past a full last page"]})   # same pair reversed: match
+    t = form_contrasts.contrasts(_scored(lambda f, e, i: (1, 0)), hyp, n_boot=200)
+    labels = dict(zip(t["contrast"], t["label"], strict=True))
+    assert labels["has_more - next_cursor, fetch past a full last page"] == "pre-registered"
+    assert labels["total_count - nl_note_json, fetch past a full last page"] == "post hoc"  # H2b's pair, other cell
+    assert sum(v != "post hoc" for v in labels.values()) == 1
